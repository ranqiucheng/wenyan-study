        },
        {
          "surface": "踟蹰",
          "pos": "动词",
          "gloss": "徘徊不前"
        }
      ]
    },
    {
      "id": "jingnv-005",
      "order": 5,
      "text": "静女其娈，",
      "translation": "娴静的姑娘多么美好，",
      "tokens": [
        {
          "surface": "静女",
          "pos": "名词",
          "gloss": "娴静的姑娘"
        },
        {
          "surface": "其",
