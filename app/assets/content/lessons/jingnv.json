          "gloss": "表转折"
        },
        {
          "surface": "不见",
          "pos": "动词",
          "gloss": "不出现，见通“现”"
        }
      ]
    },
    {
      "id": "jingnv-004",
      "order": 4,
      "text": "搔首踟蹰。",
      "translation": "我挠着头徘徊不定。",
      "tokens": [
        {
          "surface": "搔",
          "pos": "动词",
          "gloss": "用手指挠"
