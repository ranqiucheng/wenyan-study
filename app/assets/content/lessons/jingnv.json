        },
        {
          "surface": "娈",
          "pos": "形容词",
          "gloss": "美好"
        }
      ]
    },
    {
      "id": "jingnv-006",
      "order": 6,
      "text": "贻我彤管。",
      "translation": "她送给我一支红色的管箫。",
      "tokens": [
