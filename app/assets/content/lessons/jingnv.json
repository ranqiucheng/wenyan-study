          "gloss": "初生的茅草"
        }
      ]
    },
    {
      "id": "jingnv-010",
      "order": 10,
      "text": "洵美且异。",
      "translation": "实在美丽而且奇特。",
      "tokens": [
        {
          "surface": "洵",
          "pos": "副词",
          "gloss": "实在，确实"
