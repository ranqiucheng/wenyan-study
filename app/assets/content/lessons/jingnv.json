    },
    {
      "id": "jingnv-008",
      "order": 8,
      "text": "说怿女美。",
      "translation": "我喜爱你（彤管）的美丽。",
      "tokens": [
        {
          "surface": "说",
          "pos": "动词",
          "gloss": "通“悦”，喜爱"
