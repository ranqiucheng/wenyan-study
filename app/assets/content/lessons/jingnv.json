  "reviewed": true,
  "summary": "写男子与静女相约城隅、赠物定情的场景，以细腻的动作与心理描写表现青年男女纯真热烈的爱情。",
  "sentences": [
    {
      "id": "jingnv-001",
      "order": 1,
      "text": "静女其姝，",
      "translation": "娴静的姑娘多么美丽，",
      "tokens": [
        {
          "surface": "静女",
          "pos": "名词",
          "gloss": "娴静的姑娘"
        },
        {
          "surface": "其",
          "pos": "助词",
          "gloss": "形容词词头，起加强作用"
        },
        {
          "surface": "姝",
          "pos": "形容词",
          "gloss": "美丽"
        }
      ]
    },
    {
      "id": "jingnv-002",
      "order": 2,
      "text": "俟我于城隅。",
      "translation": "她在城墙的角落等我。",
      "tokens": [
        {
          "surface": "俟",
          "pos": "动词",
          "gloss": "等待"
        },
