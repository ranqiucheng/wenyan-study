    },
    {
      "id": "jingnv-007",
      "order": 7,
      "text": "彤管有炜，",
      "translation": "红色的管箫光泽鲜明，",
      "tokens": [
        {
          "surface": "彤管",
          "pos": "名词",
          "gloss": "红色的管乐器"
        },
