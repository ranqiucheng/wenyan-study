          "pos": "动词",
          "gloss": "拒绝"
        },
        {
          "surface": "众庶",
          "pos": "名词",
          "gloss": "百姓"
        },
        {
          "surface": "明",
          "pos": "形容词使动",
          "gloss": "使……彰明"
