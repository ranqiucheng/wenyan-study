{
  "id": "jianzhuke",
  "title": "谏逐客书",
  "author": "李斯",
  "source": "《史记》",
  "volume": "选择性必修下册",
  "tags": [
    "课标",
    "奏疏"
  ],
  "reviewed": true,
  "summary": "列举客卿有功于秦的史实与秦王喜好异国珍宝的事实，论证逐客之过，劝谏秦王收回逐客令。",
  "sentences": [
    {
      "id": "jianzhuke-001",
      "order": 1,
      "text": "臣闻吏议逐客，窃以为过矣。",
      "translation": "我听说官吏们在议论驱逐客卿，我私下认为这是错误的。",
      "tokens": [
        {
          "surface": "逐客",
          "pos": "动词",
          "gloss": "驱逐客卿"
        },
        {
          "surface": "窃",
          "pos": "副词",
          "gloss": "私下"
        },
        {
          "surface": "以为",
          "pos": "动词",
          "gloss": "认为"
        },
        {
          "surface": "过",
          "pos": "形容词",
          "gloss": "错误"
        }
      ]
    },
    {
      "id": "jianzhuke-002",
      "order": 2,
      "text": "昔穆公求士，西取由余于戎，东得百里奚于宛，迎蹇叔于宋，来丕豹、公孙支于晋。",
      "translation": "从前秦穆公寻求贤士，向西从戎族取得由余，向东从宛地得到百里奚，从宋国迎来蹇叔，从晋国招来丕豹、公孙支。",
      "tokens": [
        {
          "surface": "求士",
          "pos": "动词",
          "gloss": "寻求贤士"
        },
        {
          "surface": "取",
          "pos": "动词",
          "gloss": "取得"
        },
        {
          "surface": "得",
          "pos": "动词",
          "gloss": "得到"
        },
        {
          "surface": "迎",
          "pos": "动词",
          "gloss": "迎来"
        },
        {
          "surface": "来",
          "pos": "动词使动",
          "gloss": "招来"
        }
      ]
    },
    {
      "id": "jianzhuke-003",
      "order": 3,
      "text": "此五子者，不产于秦，而穆公用之，并国二十，遂霸西戎。",
      "translation": "这五个人，不出生在秦国，而秦穆公任用他们，吞并了二十个国家，于是称霸西戎。",
      "tokens": [
        {
          "surface": "产",
          "pos": "动词",
          "gloss": "出生"
        },
        {
          "surface": "用",
          "pos": "动词",
          "gloss": "任用"
        },
        {
          "surface": "并",
          "pos": "动词",
          "gloss": "吞并"
        },
        {
          "surface": "霸",
          "pos": "动词",
          "gloss": "称霸"
        }
      ]
    },
    {
      "id": "jianzhuke-004",
      "order": 4,
      "text": "孝公用商鞅之法，移风易俗，民以殷盛，国以富强，百姓乐用，诸侯亲服，获楚、魏之师，举地千里，至今治强。",
      "translation": "秦孝公采用商鞅的变法，移风易俗，百姓因此殷实兴盛，国家因此富足强大，百姓乐于效力，诸侯亲近归服，战胜楚、魏的军队，攻取土地千里，直到现在政治安定、国力强盛。",
      "tokens": [
        {
          "surface": "移风易俗",
          "pos": "动词",
          "gloss": "改变风俗"
        },
        {
          "surface": "以",
          "pos": "介词",
          "gloss": "因为"
        },
        {
          "surface": "殷盛",
          "pos": "形容词",
          "gloss": "殷实兴盛"
        },
        {
          "surface": "乐用",
          "pos": "动词",
          "gloss": "乐于效力"
        },
        {
          "surface": "获",
          "pos": "动词",
          "gloss": "战胜获得"
        },
        {
          "surface": "举",
          "pos": "动词",
          "gloss": "攻取"
        },
        {
          "surface": "治强",
          "pos": "形容词",
          "gloss": "安定强盛"
        }
      ]
    },
    {
      "id": "jianzhuke-005",
      "order": 5,
      "text": "惠王用张仪之计，拔三川之地，西并巴、蜀，北收上郡，南取汉中，包九夷，制鄢、郢，东据成皋之险，割膏腴之壤，遂散六国之从，使之西面事秦，功施到今。",
      "translation": "秦惠王采用张仪的计策，攻取三川之地，向西吞并巴、蜀，向北收取上郡，向南夺取汉中，包举九夷，控制鄢、郢，向东占据成皋的险要，割取肥沃的土地，于是离散六国的合纵，使他们向西侍奉秦国，功业延续到今天。",
      "tokens": [
        {
          "surface": "拔",
          "pos": "动词",
          "gloss": "攻取"
        },
        {
          "surface": "包",
          "pos": "动词",
          "gloss": "包举"
        },
        {
          "surface": "制",
          "pos": "动词",
          "gloss": "控制"
        },
        {
          "surface": "据",
          "pos": "动词",
          "gloss": "占据"
        },
        {
          "surface": "散",
          "pos": "动词使动",
          "gloss": "使……离散"
        },
        {
          "surface": "从",
          "pos": "名词",
          "gloss": "通“纵”，合纵"
        },
        {
          "surface": "事",
          "pos": "动词",
          "gloss": "侍奉"
        },
        {
          "surface": "施",
          "pos": "动词",
          "gloss": "延续"
        }
      ]
    },
    {
      "id": "jianzhuke-006",
      "order": 6,
      "text": "昭王得范雎，废穰侯，逐华阳，强公室，杜私门，蚕食诸侯，使秦成帝业。",
      "translation": "秦昭王得到范雎，废黜穰侯，驱逐华阳君，加强王室，堵塞权贵的私门，像蚕吃桑叶一样逐步吞并诸侯，使秦国成就帝业。",
      "tokens": [
        {
          "surface": "废",
          "pos": "动词",
          "gloss": "废黜"
        },
        {
          "surface": "强",
          "pos": "形容词使动",
          "gloss": "使……强大"
        },
        {
          "surface": "杜",
          "pos": "动词",
          "gloss": "堵塞"
        },
        {
          "surface": "私门",
          "pos": "名词",
          "gloss": "权贵的私门"
        },
        {
          "surface": "蚕食",
          "pos": "名词作状语",
          "gloss": "像蚕一样吞食"
        }
      ]
    },
    {
      "id": "jianzhuke-007",
      "order": 7,
      "text": "此四君者，皆以客之功。",
      "translation": "这四位君主，都依靠客卿的功劳。",
      "tokens": [
        {
          "surface": "以",
          "pos": "介词",
          "gloss": "依靠"
        },
        {
          "surface": "客",
          "pos": "名词",
          "gloss": "客卿"
        },
        {
          "surface": "功",
          "pos": "名词",
          "gloss": "功劳"
        }
      ]
    },
    {
      "id": "jianzhuke-008",
      "order": 8,
      "text": "由此观之，客何负于秦哉！",
      "translation": "由此看来，客卿有什么对不起秦国的地方呢！",
      "tokens": [
        {
          "surface": "由",
          "pos": "介词",
          "gloss": "从"
        },
        {
          "surface": "负",
          "pos": "动词",
          "gloss": "对不起、辜负"
        },
        {
          "surface": "于",
          "pos": "介词",
          "gloss": "对"
        }
      ]
    },
    {
      "id": "jianzhuke-009",
      "order": 9,
      "text": "向使四君却客而不内，疏士而不用，是使国无富利之实而秦无强大之名也。",
      "translation": "假使四位君主拒绝客卿而不接纳，疏远贤士而不任用，这就使国家没有富足的实际而秦国没有强大的名声。",
      "tokens": [
        {
          "surface": "向使",
          "pos": "连词",
          "gloss": "假使"
        },
        {
          "surface": "却",
          "pos": "动词",
          "gloss": "拒绝"
        },
        {
          "surface": "内",
          "pos": "动词",
          "gloss": "通“纳”，接纳"
        },
        {
          "surface": "疏",
          "pos": "动词",
          "gloss": "疏远"
        },
        {
          "surface": "是",
          "pos": "代词",
          "gloss": "这"
        },
        {
          "surface": "实",
          "pos": "名词",
          "gloss": "实际"
        }
      ]
    },
    {
      "id": "jianzhuke-010",
      "order": 10,
      "text": "今陛下致昆山之玉，有随、和之宝，垂明月之珠，服太阿之剑，乘纤离之马，建翠凤之旗，树灵鼍之鼓。",
      "translation": "如今陛下得到昆山的美玉，拥有随侯珠、和氏璧这样的宝物，悬挂明月珠，佩带太阿剑，乘坐纤离马，树立翠凤旗，架起灵鼍鼓。",
      "tokens": [
        {
          "surface": "致",
          "pos": "动词",
          "gloss": "得到"
        },
        {
          "surface": "垂",
          "pos": "动词",
          "gloss": "悬挂"
        },
        {
          "surface": "服",
          "pos": "动词",
          "gloss": "佩带"
        },
        {
          "surface": "乘",
          "pos": "动词",
          "gloss": "乘坐"
        },
        {
          "surface": "建",
          "pos": "动词",
          "gloss": "树立"
        },
        {
          "surface": "树",
          "pos": "动词",
          "gloss": "架起"
        }
      ]
    },
    {
      "id": "jianzhuke-011",
      "order": 11,
      "text": "此数宝者，秦不生一焉，而陛下说之，何也？",
      "translation": "这几件宝物，秦国一件也不出产，而陛下却喜欢它们，为什么呢？",
      "tokens": [
        {
          "surface": "数",
          "pos": "形容词",
          "gloss": "几"
        },
        {
          "surface": "生",
          "pos": "动词",
          "gloss": "出产"
        },
        {
          "surface": "说",
          "pos": "动词",
          "gloss": "通“悦”，喜欢"
        },
        {
          "surface": "何也",
          "pos": "固定结构",
          "gloss": "为什么呢"
        }
      ]
    },
    {
      "id": "jianzhuke-012",
      "order": 12,
      "text": "必秦国之所生然后可，则是夜光之璧不饰朝廷，犀象之器不为玩好，郑、卫之女不充后宫，而骏良駃騠不实外厩，江南金锡不为用，西蜀丹青不为采。",
      "translation": "一定要秦国出产的才行，那么夜光璧就不装饰朝廷，犀角象牙的器物就不成为玩好，郑、卫的美女就不充实后宫，骏马駃騠就不充满外边的马棚，江南的金锡就不被使用，西蜀的丹青就不被采用。",
      "tokens": [
        {
          "surface": "饰",
          "pos": "动词",
          "gloss": "装饰"
        },
        {
          "surface": "玩好",
          "pos": "名词",
          "gloss": "玩赏之物"
        },
        {
          "surface": "充",
          "pos": "动词",
          "gloss": "充实"
        },
        {
          "surface": "实",
          "pos": "动词",
          "gloss": "充满"
        },
        {
          "surface": "采",
          "pos": "动词",
          "gloss": "采用"
        }
      ]
    },
    {
      "id": "jianzhuke-013",
      "order": 13,
      "text": "所以饰后宫、充下陈、娱心意、说耳目者，必出于秦然后可，则是宛珠之簪、傅玑之珥、阿缟之衣、锦绣之饰不进于前，而随俗雅化、佳冶窈窕赵女不立于侧也。",
      "translation": "用来装饰后宫、充实侍妾、娱乐心意、愉悦耳目的东西，一定要秦国出产才行，那么宛珠的簪子、镶珠的耳饰、阿缟的衣服、锦绣的装饰就不进献到面前，而那些随俗雅化、艳丽窈窕的赵国女子就不会侍立在身旁了。",
      "tokens": [
        {
          "surface": "所以",
          "pos": "固定结构",
          "gloss": "用来……的"
        },
        {
          "surface": "下陈",
          "pos": "名词",
          "gloss": "侍妾"
        },
        {
          "surface": "说",
          "pos": "动词",
          "gloss": "通“悦”，使……愉悦"
        },
        {
          "surface": "傅玑",
          "pos": "动词",
          "gloss": "镶嵌珠玉"
        },
        {
          "surface": "佳冶",
          "pos": "形容词",
          "gloss": "艳丽"
        },
        {
          "surface": "窈窕",
          "pos": "形容词",
          "gloss": "美好"
        },
        {
          "surface": "立",
          "pos": "动词",
          "gloss": "侍立"
        }
      ]
    },
    {
      "id": "jianzhuke-014",
      "order": 14,
      "text": "夫击瓮叩缶，弹筝搏髀，而歌呼呜呜快耳者，真秦之声也；",
      "translation": "敲击瓦瓮瓦缶，弹着筝拍着大腿，呜呜地歌唱以快意于耳的，才是真正秦国的音乐；",
      "tokens": [
        {
          "surface": "击瓮叩缶",
          "pos": "动词",
          "gloss": "敲击瓦器"
        },
        {
          "surface": "搏髀",
          "pos": "动词",
          "gloss": "拍大腿打拍子"
        },
        {
          "surface": "快耳",
          "pos": "动词使动",
          "gloss": "使耳朵快意"
        },
        {
          "surface": "声",
          "pos": "名词",
          "gloss": "音乐"
        }
      ]
    },
    {
      "id": "jianzhuke-015",
      "order": 15,
      "text": "《郑》《卫》《桑间》《韶》《虞》《武》《象》者，异国之乐也。",
      "translation": "《郑》《卫》《桑间》《韶》《虞》《武》《象》，都是别国的音乐。",
      "tokens": [
        {
          "surface": "者",
          "pos": "助词",
          "gloss": "表停顿"
        },
        {
          "surface": "异国",
          "pos": "名词",
          "gloss": "别的国家"
        },
        {
          "surface": "乐",
          "pos": "名词",
          "gloss": "音乐"
        }
      ]
    },
    {
      "id": "jianzhuke-016",
      "order": 16,
      "text": "今弃击瓮叩缶而就《郑》《卫》，退弹筝而取《韶》《虞》，若是者何也？",
      "translation": "如今抛弃敲击瓦瓮瓦缶而接近《郑》《卫》之音，撤去弹筝而采用《韶》《虞》之乐，像这样做是为什么呢？",
      "tokens": [
        {
          "surface": "就",
          "pos": "动词",
          "gloss": "接近、取用"
        },
        {
          "surface": "退",
          "pos": "动词",
          "gloss": "撤去"
        },
        {
          "surface": "取",
          "pos": "动词",
          "gloss": "采用"
        },
        {
          "surface": "若是",
          "pos": "代词",
          "gloss": "像这样"
        }
      ]
    },
    {
      "id": "jianzhuke-017",
      "order": 17,
      "text": "快意当前，适观而已矣。",
      "translation": "只是为了使当前心意快适、看起来舒适罢了。",
      "tokens": [
        {
          "surface": "快意",
          "pos": "动词",
          "gloss": "使心意快适"
        },
        {
          "surface": "适观",
          "pos": "动词",
          "gloss": "看着舒适"
        },
        {
          "surface": "而已",
          "pos": "助词",
          "gloss": "罢了"
        }
      ]
    },
    {
      "id": "jianzhuke-018",
      "order": 18,
      "text": "今取人则不然，不问可否，不论曲直，非秦者去，为客者逐。",
      "translation": "如今用人却不是这样，不问是否合适，不论是非曲直，不是秦国人就离开，是客卿就驱逐。",
      "tokens": [
        {
          "surface": "取人",
          "pos": "动词",
          "gloss": "用人"
        },
        {
          "surface": "不然",
          "pos": "代词",
          "gloss": "不是这样"
        },
        {
          "surface": "可否",
          "pos": "名词",
          "gloss": "是否合适"
        },
        {
          "surface": "曲直",
          "pos": "名词",
          "gloss": "是非"
        },
        {
          "surface": "去",
          "pos": "动词",
          "gloss": "离开"
        },
        {
          "surface": "逐",
          "pos": "动词",
          "gloss": "驱逐"
        }
      ]
    },
    {
      "id": "jianzhuke-019",
      "order": 19,
      "text": "然则是所重者在乎色、乐、珠玉，而所轻者在乎人民也。",
      "translation": "既然如此，那么你所看重的在于女色、音乐、珠玉，而所轻视的在于百姓。",
      "tokens": [
        {
          "surface": "然则",
          "pos": "连词",
          "gloss": "既然如此，那么"
        },
        {
          "surface": "重",
          "pos": "动词",
          "gloss": "看重"
        },
        {
          "surface": "乎",
          "pos": "介词",
          "gloss": "于"
        },
        {
          "surface": "轻",
          "pos": "动词",
          "gloss": "轻视"
        },
        {
          "surface": "人民",
          "pos": "名词",
          "gloss": "百姓"
        }
      ]
    },
    {
      "id": "jianzhuke-020",
      "order": 20,
      "text": "此非所以跨海内、制诸侯之术也。",
      "translation": "这不是用来统一天下、控制诸侯的办法。",
      "tokens": [
        {
          "surface": "所以",
          "pos": "固定结构",
          "gloss": "用来……的"
        },
        {
          "surface": "跨",
          "pos": "动词",
          "gloss": "统一、占据"
        },
        {
          "surface": "制",
          "pos": "动词",
          "gloss": "控制"
        },
        {
          "surface": "术",
          "pos": "名词",
          "gloss": "办法"
        }
      ]
    },
    {
      "id": "jianzhuke-021",
      "order": 21,
      "text": "臣闻地广者粟多，国大者人众，兵强则士勇。",
      "translation": "我听说土地广阔粮食就多，国家强大人口就多，军队强大士兵就勇敢。",
      "tokens": [
        {
          "surface": "广",
          "pos": "形容词",
          "gloss": "广阔"
        },
        {
          "surface": "粟",
          "pos": "名词",
          "gloss": "粮食"
        },
        {
          "surface": "众",
          "pos": "形容词",
          "gloss": "多"
        },
        {
          "surface": "兵",
          "pos": "名词",
          "gloss": "军队"
        },
        {
          "surface": "则",
