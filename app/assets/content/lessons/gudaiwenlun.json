          "gloss": "迹象，境界"
        },
        {
          "surface": "务",
          "pos": "副词",
          "gloss": "务必"
        },
        {
          "surface": "博观",
          "pos": "动词",
          "gloss": "广泛观察"
        }
      ]
    }
  ]
}
