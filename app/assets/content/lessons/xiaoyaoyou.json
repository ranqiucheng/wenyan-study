          "gloss": "通“返”"
        }
      ]
    },
    {
      "id": "xiaoyaoyou-033",
      "order": 33,
      "text": "彼于致福者，未数数然也。",
      "translation": "他对于求福的事，并不汲汲追求。",
      "tokens": [
        {
          "surface": "致福",
          "pos": "动词",
          "gloss": "求福"
        },
        {
          "surface": "数数然",
          "pos": "形容词",
          "gloss": "汲汲追求的样子"
        }
      ]
    },
    {
      "id": "xiaoyaoyou-034",
      "order": 34,
      "text": "此虽免乎行，犹有所待者也。",
      "translation": "这样虽然免于步行，但还是有所凭借的。",
      "tokens": [
        {
          "surface": "虽",
          "pos": "连词",
          "gloss": "虽然"
        },
        {
          "surface": "免乎行",
          "pos": "动词",
          "gloss": "免于步行"
        },
        {
          "surface": "有所待",
          "pos": "固定结构",
          "gloss": "有所凭借，有待"
        }
      ]
    },
    {
      "id": "xiaoyaoyou-035",
      "order": 35,
      "text": "若夫乘天地之正，而御六气之辩，以游无穷者，彼且恶乎待哉？",
      "translation": "至于顺应天地的本性，驾御六气的变化，以遨游于无穷之境的人，他还要凭借什么呢？",
      "tokens": [
        {
          "surface": "若夫",
          "pos": "连词",
          "gloss": "至于"
        },
        {
