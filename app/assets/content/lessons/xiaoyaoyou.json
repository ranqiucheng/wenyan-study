    },
    {
      "id": "xiaoyaoyou-027",
      "order": 27,
      "text": "此小大之辩也。",
      "translation": "这就是小和大的区别。",
      "tokens": [
        {
          "surface": "小大",
          "pos": "名词",
          "gloss": "小和大的分别"
        },
        {
          "surface": "辩",
