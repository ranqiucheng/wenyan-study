          "gloss": "通“辨”，区别"
        }
      ]
    },
    {
      "id": "xiaoyaoyou-028",
      "order": 28,
      "text": "故夫知效一官，行比一乡，德合一君，而征一国者，其自视也，亦若此矣。",
      "translation": "所以那些才智胜任一官之职、品行能合一乡之人心、德行能合国君之意、能力能取信于一国之人的人，他们看待自己，也像这样罢了。",
      "tokens": [
        {
          "surface": "效",
          "pos": "动词",
          "gloss": "胜任，效力"
        },
        {
          "surface": "比",
          "pos": "动词",
          "gloss": "合，投合"
        },
        {
          "surface": "合",
          "pos": "动词",
          "gloss": "使……满意"
        },
        {
          "surface": "征",
          "pos": "动词",
          "gloss": "取信"
        },
        {
          "surface": "自视",
          "pos": "动词",
          "gloss": "看待自己"
        }
      ]
    },
    {
      "id": "xiaoyaoyou-029",
      "order": 29,
      "text": "而宋荣子犹然笑之。",
      "translation": "而宋荣子却讥笑他们。",
      "tokens": [
        {
          "surface": "宋荣子",
          "pos": "名词",
          "gloss": "宋国贤人"
        },
        {
          "surface": "犹然",
          "pos": "形容词",
          "gloss": "讥笑的样子"
        },
        {
          "surface": "笑",
          "pos": "动词",
          "gloss": "嘲笑"
        }
      ]
    },
    {
      "id": "xiaoyaoyou-030",
      "order": 30,
      "text": "且举世誉之而不加劝，举世非之而不加沮，定乎内外之分，辩乎荣辱之境，斯已矣。",
      "translation": "再说全社会都赞誉他，他也不会因此更加奋勉；全社会都非议他，他也不会因此更加沮丧；他确定了内我和外物的分别，辨明了荣辱的界限，如此罢了。",
      "tokens": [
        {
          "surface": "举",
          "pos": "形容词",
          "gloss": "全"
        },
        {
          "surface": "劝",
          "pos": "动词",
          "gloss": "奋勉，受鼓励"
        },
        {
          "surface": "沮",
          "pos": "动词",
          "gloss": "沮丧"
        },
        {
          "surface": "内外之分",
          "pos": "名词",
          "gloss": "内我和外物的分别"
        },
        {
          "surface": "斯已矣",
          "pos": "固定结构",
          "gloss": "如此罢了"
        }
      ]
    },
    {
      "id": "xiaoyaoyou-031",
      "order": 31,
      "text": "彼其于世，未数数然也。虽然，犹有未树也。",
      "translation": "他对于世俗的名声，没有汲汲追求。虽然如此，他还是没有树立最高的境界。",
      "tokens": [
        {
          "surface": "数数然",
          "pos": "形容词",
          "gloss": "汲汲追求的样子"
        },
        {
          "surface": "虽然",
          "pos": "连词",
          "gloss": "虽然如此"
        },
        {
          "surface": "未树",
          "pos": "动词",
          "gloss": "没有树立，未达最高境界"
        }
      ]
    },
    {
      "id": "xiaoyaoyou-032",
      "order": 32,
      "text": "夫列子御风而行，泠然善也，旬有五日而后反。",
      "translation": "列子驾着风飞行，轻妙飘逸，十五天后才返回。",
      "tokens": [
        {
          "surface": "列子",
          "pos": "名词",
          "gloss": "列御寇"
        },
        {
          "surface": "御",
