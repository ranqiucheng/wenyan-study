{
  "id": "baorenan",
  "title": "报任安书（节选）",
  "author": "司马迁",
  "source": "《文选》",
  "volume": "选择性必修中册",
  "tags": [
    "课标",
    "书信"
  ],
  "reviewed": true,
  "summary": "以古代圣贤发愤著书自勉，申说自己忍辱负重、发愤著述《史记》的苦心与抱负。",
  "sentences": [
    {
      "id": "baorenan-001",
      "order": 1,
      "text": "古者富贵而名摩灭，不可胜记，唯倜傥非常之人称焉。",
      "translation": "古时候富贵而名声磨灭的人，多得无法记数，只有卓越非凡的人才被称颂。",
      "tokens": [
        {
          "surface": "摩灭",
          "pos": "动词",
          "gloss": "磨灭"
        },
        {
          "surface": "胜",
          "pos": "副词",
          "gloss": "尽"
        },
        {
          "surface": "倜傥",
          "pos": "形容词",
          "gloss": "卓越不凡"
        },
        {
          "surface": "非常",
          "pos": "形容词",
          "gloss": "不同寻常"
        },
        {
          "surface": "称",
          "pos": "动词",
          "gloss": "被称颂"
        }
      ]
    },
    {
      "id": "baorenan-002",
      "order": 2,
      "text": "盖文王拘而演《周易》；仲尼厄而作《春秋》；",
      "translation": "文王被拘禁而推演《周易》；孔子受困厄而作《春秋》；",
      "tokens": [
        {
          "surface": "盖",
          "pos": "助词",
          "gloss": "发语词"
        },
        {
          "surface": "拘",
          "pos": "动词",
          "gloss": "被拘禁"
        },
        {
          "surface": "演",
          "pos": "动词",
          "gloss": "推演"
        },
        {
          "surface": "厄",
          "pos": "动词",
          "gloss": "遭受困厄"
        },
        {
          "surface": "作",
          "pos": "动词",
          "gloss": "写作"
        }
      ]
    },
    {
      "id": "baorenan-003",
      "order": 3,
      "text": "屈原放逐，乃赋《离骚》；左丘失明，厥有《国语》；",
      "translation": "屈原被放逐，才写出《离骚》；左丘明失明，才有了《国语》；",
      "tokens": [
        {
          "surface": "放逐",
          "pos": "动词",
          "gloss": "被放逐"
        },
        {
          "surface": "乃",
          "pos": "副词",
          "gloss": "才"
        },
        {
          "surface": "赋",
          "pos": "动词",
          "gloss": "写作"
        },
        {
          "surface": "失明",
          "pos": "动词",
          "gloss": "失去视力"
        },
        {
          "surface": "厥",
          "pos": "副词",
          "gloss": "才"
        }
      ]
    },
    {
      "id": "baorenan-004",
      "order": 4,
      "text": "孙子膑脚，《兵法》修列；不韦迁蜀，世传《吕览》；",
      "translation": "孙膑被挖去膝盖骨，《兵法》才编纂出来；吕不韦被贬蜀地，世上才流传《吕览》；",
      "tokens": [
        {
          "surface": "膑脚",
          "pos": "动词",
          "gloss": "挖去膝盖骨"
        },
        {
          "surface": "修列",
          "pos": "动词",
          "gloss": "编纂"
        },
        {
          "surface": "迁",
          "pos": "动词",
          "gloss": "贬谪"
        },
        {
          "surface": "传",
          "pos": "动词",
          "gloss": "流传"
        }
      ]
    },
    {
      "id": "baorenan-005",
      "order": 5,
      "text": "韩非囚秦，《说难》《孤愤》；《诗》三百篇，大底圣贤发愤之所为作也。",
      "translation": "韩非被囚禁在秦国，才有《说难》《孤愤》；《诗经》三百篇，大抵是圣贤为抒发愤懑而作的。",
      "tokens": [
        {
          "surface": "囚",
          "pos": "动词",
          "gloss": "被囚禁"
        },
        {
          "surface": "大底",
          "pos": "副词",
          "gloss": "大抵"
        },
        {
          "surface": "发愤",
          "pos": "动词",
          "gloss": "抒发愤懑"
        },
        {
          "surface": "所为作",
          "pos": "固定结构",
          "gloss": "所创作的"
        }
      ]
    },
    {
      "id": "baorenan-006",
      "order": 6,
      "text": "此人皆意有所郁结，不得通其道，故述往事，思来者。",
      "translation": "这些人都是心中有郁结，不能实现自己的主张，所以记述往事，思虑未来的人。",
      "tokens": [
        {
          "surface": "郁结",
          "pos": "动词",
          "gloss": "郁积"
        },
        {
          "surface": "通",
          "pos": "动词",
          "gloss": "实现"
        },
        {
          "surface": "道",
          "pos": "名词",
          "gloss": "主张"
        },
        {
          "surface": "述",
          "pos": "动词",
          "gloss": "记述"
        },
        {
          "surface": "来者",
          "pos": "名词",
          "gloss": "未来的人"
        }
      ]
    },
    {
      "id": "baorenan-007",
      "order": 7,
      "text": "乃如左丘无目，孙子断足，终不可用，退而论书策，以舒其愤，思垂空文以自见。",
      "translation": "至于左丘明失明，孙膑断足，终究不能被任用，就退居著书立说，来抒发他们的愤懑，希望留下文章来表现自己。",
      "tokens": [
        {
          "surface": "无目",
          "pos": "动词",
          "gloss": "失明"
        },
        {
          "surface": "退",
          "pos": "动词",
          "gloss": "退居"
        },
        {
          "surface": "论书策",
          "pos": "动词",
          "gloss": "著书立说"
        },
        {
          "surface": "舒",
          "pos": "动词",
          "gloss": "抒发"
        },
        {
          "surface": "垂",
          "pos": "动词",
          "gloss": "流传"
        },
        {
          "surface": "自见",
          "pos": "动词",
          "gloss": "表现自己，“见”通“现”"
        }
      ]
    },
    {
      "id": "baorenan-008",
      "order": 8,
      "text": "仆窃不逊，近自托于无能之辞，网罗天下放失旧闻，略考其行事，综其终始，稽其成败兴坏之纪，",
      "translation": "我私下不自量力，近来依托拙劣的文辞，收集天下散失的旧闻，简略考订其行事，综合其始末，考察其成败兴衰的规律，",
      "tokens": [
        {
          "surface": "窃",
          "pos": "副词",
          "gloss": "私下"
        },
        {
          "surface": "不逊",
          "pos": "形容词",
          "gloss": "不自量力"
        },
        {
          "surface": "放失",
          "pos": "动词",
          "gloss": "散失"
        },
        {
          "surface": "稽",
          "pos": "动词",
          "gloss": "考察"
        },
        {
          "surface": "纪",
          "pos": "名词",
          "gloss": "规律、纲纪"
        }
      ]
    },
    {
      "id": "baorenan-009",
      "order": 9,
      "text": "上计轩辕，下至于兹，为十表，本纪十二，书八章，世家三十，列传七十，凡百三十篇。",
      "translation": "上从轩辕黄帝算起，下到现在，写成十篇表、十二篇本纪、八章书、三十篇世家、七十篇列传，共一百三十篇。",
      "tokens": [
        {
          "surface": "计",
          "pos": "动词",
          "gloss": "从……算起"
        },
        {
          "surface": "兹",
          "pos": "代词",
          "gloss": "现在"
        },
        {
          "surface": "本纪",
          "pos": "名词",
          "gloss": "记帝王事迹的体例"
        },
        {
          "surface": "凡",
          "pos": "副词",
          "gloss": "总共"
        }
      ]
    },
    {
      "id": "baorenan-010",
      "order": 10,
      "text": "亦欲以究天人之际，通古今之变，成一家之言。",
      "translation": "也是想用它来探究天道与人事的关系，贯通古今的变化，形成一家之言。",
      "tokens": [
        {
          "surface": "究",
          "pos": "动词",
          "gloss": "探究"
        },
        {
          "surface": "天人之际",
          "pos": "固定结构",
          "gloss": "天道与人事的关系"
        },
        {
          "surface": "通",
          "pos": "动词",
          "gloss": "贯通"
        },
        {
          "surface": "成",
          "pos": "动词",
          "gloss": "形成"
        }
      ]
    },
    {
      "id": "baorenan-011",
      "order": 11,
      "text": "草创未就，会遭此祸，惜其不成，是以就极刑而无愠色。",
      "translation": "草稿尚未完成，恰逢遭遇这场灾祸，我痛惜它没有完成，因此接受最重的刑罚而没有怨恨的脸色。",
      "tokens": [
        {
          "surface": "草创",
          "pos": "动词",
          "gloss": "起草"
        },
        {
          "surface": "就",
          "pos": "动词",
          "gloss": "完成"
        },
        {
          "surface": "会",
          "pos": "副词",
          "gloss": "恰逢"
        },
        {
          "surface": "是以",
          "pos": "连词",
          "gloss": "因此"
        },
        {
          "surface": "极刑",
          "pos": "名词",
          "gloss": "最重的刑罚，指宫刑"
        },
        {
          "surface": "愠色",
          "pos": "名词",
          "gloss": "怨恨的脸色"
        }
      ]
    },
    {
      "id": "baorenan-012",
      "order": 12,
      "text": "仆诚已著此书，藏之名山，传之其人，通邑大都，",
      "translation": "如果我真能写成这部书，把它藏在名山，传给志同道合的人，让它流传于大都市，",
      "tokens": [
        {
          "surface": "诚",
          "pos": "连词",
          "gloss": "如果"
        },
        {
          "surface": "著",
          "pos": "动词",
          "gloss": "写成"
        },
        {
          "surface": "传",
          "pos": "动词",
          "gloss": "传给"
        },
        {
          "surface": "通邑大都",
          "pos": "名词",
          "gloss": "大城市"
        }
      ]
    },
    {
      "id": "baorenan-013",
      "order": 13,
      "text": "则仆偿前辱之责，虽万被戮，岂有悔哉！",
      "translation": "那么我就偿还了先前受辱的债，即使被杀戮一万次，难道会有悔恨吗！",
      "tokens": [
        {
          "surface": "偿",
          "pos": "动词",
          "gloss": "偿还"
        },
        {
          "surface": "责",
          "pos": "名词",
          "gloss": "通“债”，债务"
        },
        {
          "surface": "虽",
          "pos": "连词",
          "gloss": "即使"
        },
        {
          "surface": "被戮",
          "pos": "动词",
          "gloss": "被杀"
        },
        {
          "surface": "岂",
          "pos": "副词",
          "gloss": "难道"
        }
      ]
    },
    {
      "id": "baorenan-014",
      "order": 14,
      "text": "然此可为智者道，难为俗人言也。",
      "translation": "然而这些话只能对明智的人讲，难以对世俗的人说。",
      "tokens": [
        {
          "surface": "为",
          "pos": "介词",
          "gloss": "对"
        },
        {
          "surface": "道",
          "pos": "动词",
          "gloss": "说"
        },
        {
          "surface": "俗人",
          "pos": "名词",
          "gloss": "世俗之人"
        }
      ]
    }
  ]
}
