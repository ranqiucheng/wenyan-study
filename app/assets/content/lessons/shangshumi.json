{
  "id": "shangshumi",
  "title": "上枢密韩太尉书",
  "author": "苏辙",
  "source": "《栾城集》",
  "volume": "选修推荐",
  "tags": [
    "推荐",
    "书信"
  ],
  "reviewed": true,
  "summary": "苏辙以“文者气之所形”立论，自述遍游名山大川、广交豪俊以养气，借上书求见韩琦，表达仰慕与求教之意。",
  "sentences": [
    {
      "id": "shangshumi-001",
      "order": 1,
      "text": "太尉执事：辙生好为文，思之至深。",
      "translation": "太尉执事：我生性喜好写文章，对此思考得很深。",
      "tokens": [
        {
          "surface": "执事",
          "pos": "名词",
          "gloss": "侍从，书信中对人的敬称"
        },
        {
          "surface": "生",
          "pos": "名词",
          "gloss": "生性"
        },
        {
          "surface": "好",
          "pos": "动词",
          "gloss": "喜好"
        },
        {
          "surface": "为文",
          "pos": "动词",
          "gloss": "写文章"
        },
        {
          "surface": "至深",
          "pos": "形容词",
          "gloss": "极深"
        }
      ]
    },
    {
      "id": "shangshumi-002",
      "order": 2,
      "text": "以为文者气之所形，然文不可以学而能，气可以养而致。",
      "translation": "我认为文章是气的显现，但是文章不能靠学习写得出来，气却可以通过修养而得到。",
      "tokens": [
        {
          "surface": "以为",
          "pos": "动词",
          "gloss": "认为"
        },
        {
          "surface": "气",
          "pos": "名词",
          "gloss": "指人的精神气质"
        },
        {
          "surface": "所形",
          "pos": "动词",
          "gloss": "显现出来的"
        },
        {
          "surface": "学而能",
          "pos": "动词",
          "gloss": "靠学习而能"
        },
        {
          "surface": "养而致",
          "pos": "动词",
          "gloss": "通过修养而得到"
        }
      ]
    },
    {
      "id": "shangshumi-003",
      "order": 3,
      "text": "孟子曰：“我善养吾浩然之气。”",
      "translation": "孟子说：“我善于培养我正大刚直的精神。”",
      "tokens": [
        {
          "surface": "孟子",
          "pos": "名词",
          "gloss": "孟轲"
        },
        {
          "surface": "善",
          "pos": "动词",
          "gloss": "善于"
        },
        {
          "surface": "养",
          "pos": "动词",
          "gloss": "培养"
        },
        {
          "surface": "浩然之气",
          "pos": "名词",
          "gloss": "正大刚直的精神"
        }
      ]
    },
    {
      "id": "shangshumi-004",
      "order": 4,
      "text": "今观其文章，宽厚宏博，充乎天地之间，称其气之小大。",
      "translation": "现在看他的文章，宽厚宏博，充满天地之间，与他的气的大小相称。",
      "tokens": [
        {
          "surface": "宽厚宏博",
          "pos": "形容词",
          "gloss": "宽厚宏博"
        },
        {
          "surface": "充",
          "pos": "动词",
          "gloss": "充满"
        },
        {
          "surface": "乎",
          "pos": "介词",
          "gloss": "相当于“于”，在"
        },
        {
          "surface": "称",
          "pos": "动词",
          "gloss": "相称"
        },
        {
          "surface": "小大",
          "pos": "名词",
          "gloss": "大小"
        }
      ]
    },
    {
      "id": "shangshumi-005",
      "order": 5,
      "text": "太史公行天下，周览四海名山大川，与燕、赵间豪俊交游，故其文疏荡，颇有奇气。",
      "translation": "太史公走遍天下，遍览四海的名山大川，同燕、赵一带的豪杰交游，所以他的文章疏放不羁，很有奇特的气概。",
      "tokens": [
        {
          "surface": "太史公",
          "pos": "名词",
          "gloss": "指司马迁"
        },
        {
          "surface": "周览",
          "pos": "动词",
          "gloss": "遍览"
        },
        {
          "surface": "豪俊",
          "pos": "名词",
          "gloss": "豪杰"
        },
        {
          "surface": "交游",
          "pos": "动词",
          "gloss": "交往"
        },
        {
          "surface": "疏荡",
          "pos": "形容词",
          "gloss": "疏放不羁"
        },
        {
          "surface": "奇气",
          "pos": "名词",
          "gloss": "奇特的气概"
        }
      ]
    },
    {
      "id": "shangshumi-006",
      "order": 6,
      "text": "此二子者，岂尝执笔学为如此之文哉？",
      "translation": "这两个人，难道曾经执笔学写这样的文章吗？",
      "tokens": [
        {
          "surface": "二子",
          "pos": "名词",
          "gloss": "这两个人"
        },
        {
          "surface": "岂尝",
          "pos": "副词",
          "gloss": "难道曾经"
        },
        {
          "surface": "执笔",
          "pos": "动词",
          "gloss": "拿笔"
        },
        {
          "surface": "学为",
          "pos": "动词",
          "gloss": "学写"
        },
        {
          "surface": "哉",
          "pos": "语气助词",
          "gloss": "吗，表反问"
        }
      ]
    },
    {
      "id": "shangshumi-007",
      "order": 7,
      "text": "其气充乎其中而溢乎其貌，动乎其言而见乎其文，而不自知也。",
      "translation": "他们的气充满内心而流露到外貌上，表现在言语中而显现在文章里，自己却并不知道。",
      "tokens": [
        {
          "surface": "充",
          "pos": "动词",
          "gloss": "充满"
        },
        {
          "surface": "溢",
          "pos": "动词",
          "gloss": "流露"
        },
        {
          "surface": "貌",
          "pos": "名词",
          "gloss": "外貌"
        },
        {
          "surface": "动",
          "pos": "动词",
          "gloss": "表现"
        },
        {
          "surface": "见",
          "pos": "动词",
          "gloss": "通“现”，显现"
        },
        {
          "surface": "不自知",
          "pos": "动词",
          "gloss": "自己不知道"
        }
      ]
    },
    {
      "id": "shangshumi-008",
      "order": 8,
      "text": "辙生十有九年矣。",
      "translation": "我出生已经十九年了。",
      "tokens": [
        {
          "surface": "生",
          "pos": "动词",
          "gloss": "出生，指年纪"
        },
        {
          "surface": "十有九年",
          "pos": "名词",
          "gloss": "十九年，“有”通“又”"
        },
        {
          "surface": "矣",
          "pos": "语气助词",
          "gloss": "了"
        }
      ]
    },
    {
      "id": "shangshumi-009",
      "order": 9,
      "text": "其居家所与游者，不过其邻里乡党之人。",
      "translation": "我在家时所交往的人，不过是乡里邻居这些人。",
      "tokens": [
        {
          "surface": "居家",
          "pos": "动词",
          "gloss": "在家"
        },
        {
          "surface": "所与游者",
          "pos": "固定结构",
          "gloss": "交往的人"
        },
        {
          "surface": "不过",
          "pos": "副词",
          "gloss": "只是"
        },
        {
          "surface": "邻里乡党",
          "pos": "名词",
          "gloss": "乡里邻居"
        }
      ]
    },
    {
      "id": "shangshumi-010",
      "order": 10,
      "text": "所见不过数百里之间，无高山大野可登览以自广。",
      "translation": "所看到的不过是几百里之内的地方，没有高山原野可以登临观赏来开阔自己的胸襟。",
      "tokens": [
        {
          "surface": "所见",
          "pos": "名词",
          "gloss": "看到的"
        },
        {
          "surface": "大野",
          "pos": "名词",
          "gloss": "广阔的原野"
        },
        {
          "surface": "登览",
          "pos": "动词",
          "gloss": "登临观赏"
        },
        {
          "surface": "自广",
          "pos": "动词",
          "gloss": "开阔自己的胸襟"
        }
      ]
    },
    {
      "id": "shangshumi-011",
      "order": 11,
      "text": "百氏之书，虽无所不读，然皆古人之陈迹，不足以激发其志气。",
      "translation": "诸子百家的书，虽然没有不读的，但都是古人陈旧的东西，不足以激发自己的志向气概。",
      "tokens": [
        {
          "surface": "百氏之书",
          "pos": "名词",
          "gloss": "诸子百家的书"
        },
        {
          "surface": "陈迹",
          "pos": "名词",
          "gloss": "陈旧的东西"
        },
        {
          "surface": "激发",
          "pos": "动词",
          "gloss": "激发"
        },
        {
          "surface": "志气",
          "pos": "名词",
          "gloss": "志向气概"
        }
      ]
    },
    {
      "id": "shangshumi-012",
      "order": 12,
      "text": "恐遂汩没，故决然舍去，求天下奇闻壮观，以知天地之广大。",
      "translation": "我怕就此埋没，所以决然离开家乡，寻求天下的奇闻壮观，来了解天地的广大。",
      "tokens": [
        {
          "surface": "汩没",
          "pos": "动词",
          "gloss": "埋没"
        },
        {
          "surface": "决然",
          "pos": "副词",
          "gloss": "坚决地"
        },
        {
          "surface": "舍去",
          "pos": "动词",
          "gloss": "离开"
        },
        {
          "surface": "奇闻壮观",
          "pos": "名词",
          "gloss": "奇异的见闻和雄伟的景象"
        },
        {
          "surface": "广大",
          "pos": "形容词",
          "gloss": "广阔"
        }
      ]
    },
    {
      "id": "shangshumi-013",
      "order": 13,
      "text": "过秦、汉之故都，恣观终南、嵩、华之高，北顾黄河之奔流，慨然想见古之豪杰。",
      "translation": "经过秦、汉的旧都，尽情观赏终南山、嵩山、华山的高峻，向北眺望黄河的奔流，感叹地想象古代的英雄豪杰。",
      "tokens": [
        {
          "surface": "故都",
          "pos": "名词",
          "gloss": "旧都"
        },
        {
          "surface": "恣观",
          "pos": "动词",
          "gloss": "尽情观赏"
        },
        {
          "surface": "北顾",
          "pos": "动词",
          "gloss": "向北看"
        },
        {
          "surface": "奔流",
          "pos": "名词",
          "gloss": "奔腾的水流"
        },
        {
          "surface": "慨然",
          "pos": "副词",
          "gloss": "感叹地"
        },
        {
          "surface": "想见",
          "pos": "动词",
          "gloss": "想象"
        }
      ]
    },
    {
      "id": "shangshumi-014",
      "order": 14,
      "text": "至京师，仰观天子宫阙之壮，与仓廪、府库、城池、苑囿之富且大也，而后知天下之巨丽。",
      "translation": "到了京城，仰望天子宫殿的壮丽，以及粮仓、府库、城池、园林的富足宏大，然后才知道天下的宏伟壮丽。",
      "tokens": [
        {
          "surface": "京师",
          "pos": "名词",
          "gloss": "京城"
        },
        {
          "surface": "宫阙",
          "pos": "名词",
          "gloss": "宫殿"
        },
        {
          "surface": "仓廪",
          "pos": "名词",
          "gloss": "粮仓"
        },
        {
          "surface": "苑囿",
          "pos": "名词",
          "gloss": "园林"
        },
        {
          "surface": "巨丽",
          "pos": "形容词",
          "gloss": "宏伟壮丽"
        }
      ]
    },
    {
      "id": "shangshumi-015",
      "order": 15,
      "text": "见翰林欧阳公，听其议论之宏辩，观其容貌之秀伟，与其门人贤士大夫游，而后知天下之文章聚乎此也。",
      "translation": "见到翰林学士欧阳公，听他议论的宏辩，看他容貌的秀伟，同他的门人贤士大夫交往，然后才知道天下的文章聚集在这里。",
      "tokens": [
        {
          "surface": "宏辩",
          "pos": "形容词",
          "gloss": "宏伟雄辩"
        },
        {
          "surface": "秀伟",
          "pos": "形容词",
          "gloss": "秀美魁伟"
        },
        {
          "surface": "门人",
          "pos": "名词",
          "gloss": "门生"
        },
        {
          "surface": "游",
          "pos": "动词",
          "gloss": "交往"
        },
        {
          "surface": "聚乎此",
          "pos": "固定结构",
          "gloss": "聚集在这里"
        }
      ]
    },
    {
      "id": "shangshumi-016",
      "order": 16,
      "text": "太尉以才略冠天下，天下之所恃以无忧，四夷之所惮以不敢发，入则周公、召公，出则方叔、召虎，而辙也未之见焉。",
      "translation": "太尉凭才能谋略居天下第一，天下人依靠您而无忧，四方少数民族畏惧您而不敢发难，在朝廷内像周公、召公，出外像方叔、召虎，可是我还没有见到您。",
      "tokens": [
        {
          "surface": "才略",
          "pos": "名词",
          "gloss": "才能谋略"
        },
        {
          "surface": "冠天下",
          "pos": "动词",
          "gloss": "位居天下第一"
        },
        {
          "surface": "恃",
          "pos": "动词",
          "gloss": "依靠"
        },
        {
          "surface": "惮",
          "pos": "动词",
          "gloss": "畏惧"
        },
        {
          "surface": "发",
          "pos": "动词",
          "gloss": "发难"
        },
        {
          "surface": "未之见",
          "pos": "固定结构",
          "gloss": "宾语前置，没有见到他"
        }
      ]
    },
    {
      "id": "shangshumi-017",
      "order": 17,
      "text": "且夫人之学也，不志其大，虽多而何为？",
      "translation": "况且人们学习，如果不立志于大的方面，即使学得多又有什么用呢？",
      "tokens": [
        {
          "surface": "且夫",
          "pos": "连词",
          "gloss": "况且"
        },
        {
          "surface": "志",
          "pos": "动词",
          "gloss": "立志"
        },
        {
          "surface": "大",
          "pos": "名词",
          "gloss": "大的方面"
        },
        {
          "surface": "虽",
          "pos": "连词",
          "gloss": "即使"
        },
        {
          "surface": "何为",
          "pos": "固定结构",
          "gloss": "做什么，有什么用"
        }
      ]
    },
    {
      "id": "shangshumi-018",
      "order": 18,
      "text": "辙之来也，于山见终南、嵩、华之高，于水见黄河之大且深，于人见欧阳公，而犹以为未见太尉也。",
      "translation": "我这次来，在山方面见到了终南山、嵩山、华山的高峻，在水方面见到了黄河的浩大深广，在人方面见到了欧阳公，却还认为没有见到太尉。",
      "tokens": [
        {
          "surface": "之来",
          "pos": "动词",
          "gloss": "这次来"
        },
        {
          "surface": "于",
          "pos": "介词",
          "gloss": "在……方面"
        },
        {
          "surface": "大且深",
          "pos": "形容词",
          "gloss": "又大又深"
        },
        {
          "surface": "犹",
          "pos": "副词",
          "gloss": "还"
        },
        {
          "surface": "以为",
          "pos": "动词",
          "gloss": "认为"
        }
      ]
    },
    {
      "id": "shangshumi-019",
      "order": 19,
      "text": "故愿得观贤人之光耀，闻一言以自壮，然后可以尽天下之大观而无憾者矣。",
      "translation": "所以希望能看一看贤人的光彩，听一句话来使自己的志气壮大，然后才可以看尽天下的大观而没有遗憾了。",
      "tokens": [
        {
          "surface": "光耀",
          "pos": "名词",
          "gloss": "光彩"
        },
        {
          "surface": "自壮",
          "pos": "动词",
          "gloss": "使自己的志气壮大"
        },
        {
          "surface": "尽",
          "pos": "动词",
          "gloss": "看尽"
        },
        {
          "surface": "大观",
          "pos": "名词",
          "gloss": "雄伟景象"
        },
        {
          "surface": "无憾",
          "pos": "动词",
          "gloss": "没有遗憾"
        }
      ]
    },
    {
      "id": "shangshumi-020",
      "order": 20,
      "text": "辙年少，未能通习吏事。",
      "translation": "我年纪轻，还不能通晓熟悉官吏的事务。",
      "tokens": [
        {
          "surface": "年少",
          "pos": "形容词",
          "gloss": "年纪轻"
        },
        {
          "surface": "通习",
          "pos": "动词",
          "gloss": "通晓熟悉"
        },
        {
          "surface": "吏事",
          "pos": "名词",
          "gloss": "官吏的事务"
        }
      ]
    },
    {
      "id": "shangshumi-021",
      "order": 21,
      "text": "向之来，非有取于斗升之禄，偶然得之，非其所乐。",
      "translation": "先前我来京城，并不是为了取得微薄的俸禄，偶然得到它，也不是我所喜欢的。",
      "tokens": [
        {
          "surface": "向",
          "pos": "副词",
          "gloss": "先前"
        },
        {
          "surface": "斗升之禄",
          "pos": "名词",
          "gloss": "微薄的俸禄"
        },
        {
          "surface": "偶然",
          "pos": "副词",
          "gloss": "偶然"
        },
        {
          "surface": "非其所乐",
          "pos": "固定结构",
          "gloss": "不是他所喜欢的"
        }
      ]
    },
    {
      "id": "shangshumi-022",
      "order": 22,
      "text": "然幸得赐归待选，使得优游数年之间，将以益治其文，且学为政。",
      "translation": "但是有幸得到恩赐回家等待选用，使我能在几年之间从容自得，将用来进一步钻研我的文章，并且学习处理政事。",
      "tokens": [
        {
          "surface": "赐归",
          "pos": "动词",
          "gloss": "恩赐回家"
        },
        {
          "surface": "待选",
          "pos": "动词",
          "gloss": "等待选用"
        },
        {
          "surface": "优游",
          "pos": "动词",
          "gloss": "从容自得"
        },
        {
          "surface": "益治",
          "pos": "动词",
          "gloss": "进一步钻研"
        },
        {
