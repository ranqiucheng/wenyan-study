{
  "id": "lingguan",
  "title": "五代史伶官传序",
  "author": "欧阳修",
  "source": "《新五代史》",
  "volume": "选择性必修中册",
  "tags": [
    "课标",
    "序"
  ],
  "reviewed": true,
  "summary": "通过后唐庄宗得天下与失天下的对比，论证盛衰成败在于人事，提出“忧劳可以兴国，逸豫可以亡身”的告诫。",
  "sentences": [
    {
      "id": "lingguan-001",
      "order": 1,
      "text": "呜呼！盛衰之理，虽曰天命，岂非人事哉！",
      "translation": "唉！国家盛衰的道理，虽然说是天命，难道不是由于人事吗！",
      "tokens": [
        {
          "surface": "呜呼",
          "pos": "叹词",
          "gloss": "唉，表感叹"
        },
        {
          "surface": "盛衰",
          "pos": "名词",
          "gloss": "兴盛和衰亡"
        },
        {
          "surface": "虽",
          "pos": "连词",
          "gloss": "虽然"
        },
        {
          "surface": "天命",
          "pos": "名词",
          "gloss": "上天的意旨"
        },
        {
          "surface": "岂非",
          "pos": "副词",
          "gloss": "难道不是"
        },
        {
          "surface": "人事",
          "pos": "名词",
          "gloss": "人的作为"
        }
      ]
    },
    {
      "id": "lingguan-002",
      "order": 2,
      "text": "原庄宗之所以得天下，与其所以失之者，可以知之矣。",
      "translation": "推究庄宗取得天下的原因，和他失去天下的原因，就可以知道了。",
      "tokens": [
        {
          "surface": "原",
          "pos": "动词",
          "gloss": "推究"
        },
        {
          "surface": "之所以",
          "pos": "固定结构",
          "gloss": "……的原因"
        },
        {
          "surface": "得天下",
          "pos": "动词",
          "gloss": "取得天下"
        },
        {
          "surface": "与其",
          "pos": "连词",
          "gloss": "和，及"
        },
        {
          "surface": "失之",
          "pos": "动词",
          "gloss": "失去它"
        }
      ]
    },
    {
      "id": "lingguan-003",
      "order": 3,
      "text": "世言晋王之将终也，以三矢赐庄宗而告之曰：梁，吾仇也；燕王，吾所立；契丹与吾约为兄弟，而皆背晋以归梁。",
      "translation": "世人传说晋王将要死的时候，拿三支箭赐给庄宗并告诉他说：梁国，是我的仇人；燕王，是我扶立的；契丹同我结为兄弟，却都背叛晋王而归附梁国。",
      "tokens": [
        {
          "surface": "世言",
          "pos": "动词",
          "gloss": "世人传说"
        },
        {
          "surface": "将终",
          "pos": "动词",
          "gloss": "将要死"
        },
        {
          "surface": "三矢",
          "pos": "名词",
          "gloss": "三支箭"
        },
        {
          "surface": "赐",
          "pos": "动词",
          "gloss": "赐给"
        },
        {
          "surface": "梁",
          "pos": "名词",
          "gloss": "后梁，指梁王朱温"
        },
        {
          "surface": "吾仇",
          "pos": "名词",
          "gloss": "我的仇人"
        },
        {
          "surface": "背晋",
          "pos": "动词",
          "gloss": "背叛晋王"
        },
        {
          "surface": "归梁",
          "pos": "动词",
          "gloss": "归附后梁"
        }
      ]
    },
    {
      "id": "lingguan-004",
      "order": 4,
      "text": "此三者，吾遗恨也。",
      "translation": "这三件事，是我的遗憾。",
      "tokens": [
        {
          "surface": "此三者",
          "pos": "名词",
          "gloss": "这三件事"
        },
        {
          "surface": "遗恨",
          "pos": "名词",
          "gloss": "遗留下的遗憾"
        }
      ]
    },
    {
      "id": "lingguan-005",
      "order": 5,
      "text": "与尔三矢，尔其无忘乃父之志！",
      "translation": "给你三支箭，你一定不要忘记你父亲的志向！",
      "tokens": [
        {
          "surface": "与",
          "pos": "动词",
          "gloss": "给"
        },
        {
          "surface": "尔",
          "pos": "代词",
          "gloss": "你"
        },
        {
          "surface": "其",
          "pos": "副词",
          "gloss": "一定，表祈使"
        },
        {
          "surface": "乃父",
          "pos": "代词",
          "gloss": "你的父亲"
        },
        {
          "surface": "志",
          "pos": "名词",
          "gloss": "志向"
        }
      ]
    },
    {
      "id": "lingguan-006",
      "order": 6,
      "text": "庄宗受而藏之于庙。",
      "translation": "庄宗接受了箭，把它收藏在祖庙里。",
      "tokens": [
        {
          "surface": "受",
          "pos": "动词",
          "gloss": "接受"
        },
        {
          "surface": "藏",
          "pos": "动词",
          "gloss": "收藏"
        },
        {
          "surface": "庙",
          "pos": "名词",
          "gloss": "祖庙"
        }
      ]
    },
    {
      "id": "lingguan-007",
      "order": 7,
      "text": "其后用兵，则遣从事以一少牢告庙，请其矢，盛以锦囊，负而前驱，及凯旋而纳之。",
      "translation": "此后出兵，就派属官用猪羊各一头的少牢祭告祖庙，请出那三支箭，用锦囊盛着，背着它走在前面，等到胜利归来再把箭放回祖庙。",
      "tokens": [
        {
          "surface": "从事",
          "pos": "名词",
          "gloss": "属官"
        },
        {
          "surface": "少牢",
          "pos": "名词",
          "gloss": "猪羊各一头的祭品"
        },
        {
          "surface": "告庙",
          "pos": "动词",
          "gloss": "祭告祖庙"
        },
        {
          "surface": "锦囊",
          "pos": "名词",
          "gloss": "锦缎做的袋子"
        },
        {
          "surface": "负",
          "pos": "动词",
          "gloss": "背着"
        },
        {
          "surface": "前驱",
          "pos": "动词",
          "gloss": "走在前面"
        },
        {
          "surface": "纳",
          "pos": "动词",
          "gloss": "放回"
        }
      ]
    },
    {
      "id": "lingguan-008",
      "order": 8,
      "text": "方其系燕父子以组，函梁君臣之首，入于太庙，还矢先王，而告以成功，其意气之盛，可谓壮哉！",
      "translation": "当庄宗用绳索捆绑燕王父子，用木匣装着梁国君臣的头颅，进入太庙，把箭还给先王，把成功的消息禀告先王，他意气风发，可以说是雄壮啊！",
      "tokens": [
        {
          "surface": "方",
          "pos": "介词",
          "gloss": "当……时"
        },
        {
          "surface": "系",
          "pos": "动词",
          "gloss": "捆绑"
        },
        {
          "surface": "组",
          "pos": "名词",
          "gloss": "绳索"
        },
        {
          "surface": "函",
          "pos": "动词",
          "gloss": "用木匣装"
        },
        {
          "surface": "太庙",
          "pos": "名词",
          "gloss": "祖庙"
        },
        {
          "surface": "还矢",
          "pos": "动词",
          "gloss": "归还箭"
        },
        {
          "surface": "意气",
          "pos": "名词",
          "gloss": "意志气概"
        }
      ]
    },
    {
      "id": "lingguan-009",
      "order": 9,
      "text": "及仇雠已灭，天下已定，一夫夜呼，乱者四应，仓皇东出，未及见贼而士卒离散，君臣相顾，不知所归。",
      "translation": "等到仇敌已经消灭，天下已经平定，一个人在夜里呼喊，作乱的人便四面响应，庄宗匆忙向东出逃，还没见到叛军而士卒已经离散，君臣相对而视，不知道归向何处。",
      "tokens": [
        {
          "surface": "仇雠",
          "pos": "名词",
          "gloss": "仇敌"
        },
        {
          "surface": "一夫",
          "pos": "名词",
          "gloss": "一个人"
        },
        {
          "surface": "夜",
          "pos": "名词作状语",
          "gloss": "在夜里"
        },
        {
          "surface": "四应",
          "pos": "动词",
          "gloss": "四面响应"
        },
        {
          "surface": "仓皇",
          "pos": "形容词",
          "gloss": "匆忙急迫"
        },
        {
          "surface": "相顾",
          "pos": "动词",
          "gloss": "相对而视"
        }
      ]
    },
    {
      "id": "lingguan-010",
      "order": 10,
      "text": "至于誓天断发，泣下沾襟，何其衰也！",
      "translation": "以至于对天发誓、剪断头发，眼泪流下沾湿衣襟，多么衰败啊！",
      "tokens": [
        {
          "surface": "誓天",
          "pos": "动词",
          "gloss": "对天发誓"
        },
        {
          "surface": "断发",
          "pos": "动词",
          "gloss": "剪断头发"
        },
        {
          "surface": "泣下",
          "pos": "动词",
          "gloss": "眼泪流下"
        },
        {
          "surface": "沾襟",
          "pos": "动词",
          "gloss": "沾湿衣襟"
        },
        {
          "surface": "何其",
          "pos": "副词",
          "gloss": "多么"
        }
      ]
    },
    {
      "id": "lingguan-011",
      "order": 11,
      "text": "岂得之难而失之易欤？",
      "translation": "难道是取得天下困难而失去天下容易吗？",
      "tokens": [
        {
          "surface": "岂",
          "pos": "副词",
          "gloss": "难道"
        },
        {
          "surface": "得之",
          "pos": "动词",
          "gloss": "得到天下"
        },
        {
          "surface": "失之",
          "pos": "动词",
          "gloss": "失去天下"
        },
        {
          "surface": "欤",
          "pos": "语气助词",
          "gloss": "吗，表疑问"
        }
      ]
    },
    {
      "id": "lingguan-012",
      "order": 12,
      "text": "抑本其成败之迹，而皆自于人欤？",
      "translation": "还是推究他成功与失败的事迹，都出自于人的作为呢？",
      "tokens": [
        {
          "surface": "抑",
          "pos": "连词",
          "gloss": "还是，表选择"
        },
        {
          "surface": "本",
          "pos": "动词",
          "gloss": "推究"
        },
        {
          "surface": "迹",
          "pos": "名词",
          "gloss": "事迹，道理"
        },
        {
          "surface": "自于",
          "pos": "固定结构",
          "gloss": "出自于"
        }
      ]
    },
    {
      "id": "lingguan-013",
      "order": 13,
      "text": "《书》曰：“满招损，谦得益。”",
      "translation": "《尚书》说：“自满招致损害，谦虚得到益处。”",
      "tokens": [
        {
          "surface": "书",
          "pos": "名词",
          "gloss": "指《尚书》"
        },
        {
          "surface": "满",
          "pos": "动词",
          "gloss": "自满"
        },
        {
          "surface": "招损",
          "pos": "动词",
          "gloss": "招致损害"
        },
        {
          "surface": "谦",
          "pos": "动词",
          "gloss": "谦虚"
        },
        {
          "surface": "得益",
          "pos": "动词",
          "gloss": "得到益处"
        }
      ]
    },
    {
      "id": "lingguan-014",
      "order": 14,
      "text": "忧劳可以兴国，逸豫可以亡身，自然之理也。",
      "translation": "忧虑辛劳可以使国家兴盛，安闲享乐可以使自身灭亡，这是自然的道理。",
      "tokens": [
        {
          "surface": "忧劳",
          "pos": "动词",
          "gloss": "忧虑辛劳"
        },
        {
          "surface": "兴国",
          "pos": "动词",
          "gloss": "使国家兴盛（使动用法）"
        },
        {
          "surface": "逸豫",
          "pos": "动词",
          "gloss": "安闲享乐"
        },
        {
          "surface": "亡身",
          "pos": "动词",
          "gloss": "使自身灭亡（使动用法）"
        },
        {
          "surface": "自然之理",
          "pos": "名词",
          "gloss": "自然的道理"
        }
      ]
    },
    {
      "id": "lingguan-015",
      "order": 15,
      "text": "故方其盛也，举天下之豪杰莫能与之争。",
      "translation": "所以当他兴盛时，全天下的豪杰没有谁能与他争锋。",
      "tokens": [
        {
          "surface": "举",
          "pos": "形容词",
          "gloss": "全，所有的"
        },
        {
          "surface": "莫",
          "pos": "代词",
          "gloss": "没有谁"
        },
        {
          "surface": "与之争",
          "pos": "动词",
          "gloss": "与他争锋"
        }
      ]
    },
    {
      "id": "lingguan-016",
      "order": 16,
      "text": "及其衰也，数十伶人困之，而身死国灭，为天下笑。",
      "translation": "等到他衰败时，几十个伶人围困他，就自己身死、国家灭亡，被天下人耻笑。",
      "tokens": [
        {
          "surface": "及",
          "pos": "介词",
          "gloss": "等到"
        },
        {
          "surface": "伶人",
          "pos": "名词",
          "gloss": "乐工，演戏的人"
        },
        {
          "surface": "困",
          "pos": "动词",
          "gloss": "围困"
        },
        {
          "surface": "身死国灭",
          "pos": "固定结构",
          "gloss": "自己身死，国家灭亡"
        },
        {
          "surface": "为",
          "pos": "介词",
          "gloss": "被"
        }
      ]
    },
    {
      "id": "lingguan-017",
      "order": 17,
      "text": "夫祸患常积于忽微，而智勇多困于所溺，岂独伶人也哉！",
      "translation": "祸患常常是从细微的事情积累起来的，而有智谋勇气的人往往被自己溺爱的事物困扰，难道只是伶人吗！",
      "tokens": [
        {
          "surface": "祸患",
          "pos": "名词",
          "gloss": "灾祸"
        },
        {
          "surface": "忽微",
          "pos": "名词",
          "gloss": "细微的事情"
        },
        {
          "surface": "智勇",
          "pos": "名词",
          "gloss": "有智谋勇气的人"
        },
        {
          "surface": "所溺",
          "pos": "名词",
          "gloss": "溺爱的事物"
        },
        {
          "surface": "独",
          "pos": "副词",
          "gloss": "只是"
        }
      ]
    }
  ]
}
