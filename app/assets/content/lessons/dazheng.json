{
  "id": "dazheng",
  "title": "答司马谏议书",
  "author": "王安石",
  "source": "《临川先生文集》",
  "volume": "必修下册",
  "tags": [
    "课标",
    "书信"
  ],
  "reviewed": true,
  "summary": "王安石答复司马光来信，逐条驳斥“侵官、生事、征利、拒谏”的指责，表明坚持变法、不避怨谤的立场。",
  "sentences": [
    {
      "id": "dazheng-001",
      "order": 1,
      "text": "某启：昨日蒙教，窃以为与君实游处相好之日久，而议事每不合，所操之术多异故也。",
      "translation": "王安石启：昨天承蒙您来信指教，我私下认为与君实交往相好的日子很久了，但是议论政事常常意见不合，是因为所持的政治主张有很多不同的缘故。",
      "tokens": [
        {
          "surface": "某",
          "pos": "代词",
          "gloss": "王安石自称，谦辞"
        },
        {
          "surface": "蒙教",
          "pos": "动词",
          "gloss": "承蒙指教"
        },
        {
          "surface": "窃",
          "pos": "副词",
          "gloss": "私下"
        },
        {
          "surface": "游处",
          "pos": "动词",
          "gloss": "交往相处"
        },
        {
          "surface": "每",
          "pos": "副词",
          "gloss": "每每，常常"
        },
        {
          "surface": "所操之术",
          "pos": "名词",
          "gloss": "所持的政治主张"
        }
      ]
    },
    {
      "id": "dazheng-002",
      "order": 2,
      "text": "虽欲强聒，终必不蒙见察，故略上报，不复一一自辨。",
      "translation": "虽然想要勉强多说几句，但最终一定不会被您理解，所以只简略地给您回信，不再一一为自己辩解。",
      "tokens": [
        {
          "surface": "强聒",
          "pos": "动词",
          "gloss": "勉强多说"
        },
        {
          "surface": "见察",
          "pos": "动词",
          "gloss": "被理解"
        },
        {
          "surface": "略",
          "pos": "副词",
          "gloss": "简略地"
        },
        {
          "surface": "上报",
          "pos": "动词",
          "gloss": "回信"
        },
        {
          "surface": "自辨",
          "pos": "动词",
          "gloss": "为自己辩解"
        }
      ]
    },
    {
      "id": "dazheng-003",
      "order": 3,
      "text": "盖念蒙君实视遇厚，于反覆不宜卤莽，故今具道所以，冀君实或见恕也。",
      "translation": "大概是考虑到承蒙君实看待我情谊深厚，在书信往来上不应鲁莽，所以现在详细说明这样做的原因，希望君实或许能原谅我。",
      "tokens": [
        {
          "surface": "盖",
          "pos": "副词",
          "gloss": "大概"
        },
        {
          "surface": "视遇",
          "pos": "动词",
          "gloss": "看待，对待"
        },
        {
          "surface": "反覆",
          "pos": "名词",
          "gloss": "书信往来"
        },
        {
          "surface": "卤莽",
          "pos": "形容词",
          "gloss": "鲁莽"
        },
        {
          "surface": "具道",
          "pos": "动词",
          "gloss": "详细说明"
        },
        {
          "surface": "所以",
          "pos": "名词",
          "gloss": "……的原因"
        },
        {
          "surface": "冀",
          "pos": "动词",
          "gloss": "希望"
        }
      ]
    },
    {
      "id": "dazheng-004",
      "order": 4,
      "text": "盖儒者所争，尤在于名实，名实已明，而天下之理得矣。",
      "translation": "读书人所争论的，尤其在于名义和实际是否相符，名义和实际已经辨明，那么天下的道理也就清楚了。",
      "tokens": [
        {
          "surface": "儒者",
          "pos": "名词",
          "gloss": "读书人"
        },
        {
          "surface": "尤",
          "pos": "副词",
          "gloss": "尤其"
        },
        {
          "surface": "名实",
          "pos": "名词",
          "gloss": "名义和实际"
        },
        {
          "surface": "明",
          "pos": "形容词",
          "gloss": "辨明"
        },
        {
          "surface": "得",
          "pos": "动词",
          "gloss": "得到，清楚"
        }
      ]
    },
    {
      "id": "dazheng-005",
      "order": 5,
      "text": "今君实所以见教者，以为侵官、生事、征利、拒谏，以致天下怨谤也。",
      "translation": "现在君实用来指教我的，是认为我侵夺原有官吏的职权、惹是生非、与民争利、拒绝接受意见，因此招致天下人的怨恨和诽谤。",
      "tokens": [
        {
          "surface": "所以",
          "pos": "固定结构",
          "gloss": "用来……的"
        },
        {
          "surface": "见教",
          "pos": "动词",
          "gloss": "指教我"
        },
        {
          "surface": "侵官",
          "pos": "动词",
          "gloss": "侵夺原有官吏的职权"
        },
        {
          "surface": "生事",
          "pos": "动词",
          "gloss": "惹是生非"
        },
        {
          "surface": "征利",
          "pos": "动词",
          "gloss": "与民争利"
        },
        {
          "surface": "拒谏",
          "pos": "动词",
          "gloss": "拒绝劝告"
        }
      ]
    },
    {
      "id": "dazheng-006",
      "order": 6,
      "text": "某则以谓受命于人主，议法度而修之于朝廷，以授之于有司，不为侵官。",
      "translation": "我却认为从君主那里接受命令，议订法令制度并在朝廷上修订它，然后交给负有专责的官吏去执行，不能算是侵夺职权。",
      "tokens": [
        {
          "surface": "以谓",
          "pos": "动词",
          "gloss": "认为"
        },
        {
          "surface": "人主",
          "pos": "名词",
          "gloss": "君主"
        },
        {
          "surface": "法度",
          "pos": "名词",
          "gloss": "法令制度"
        },
        {
          "surface": "修",
          "pos": "动词",
          "gloss": "修订"
        },
        {
          "surface": "有司",
          "pos": "名词",
          "gloss": "负有专责的官吏"
        },
        {
          "surface": "不为",
          "pos": "动词",
          "gloss": "不算"
        }
      ]
    },
    {
      "id": "dazheng-007",
      "order": 7,
      "text": "举先王之政，以兴利除弊，不为生事。",
      "translation": "施行前代君王的政令，来兴办好事、除去弊端，不能算是惹是生非。",
      "tokens": [
        {
          "surface": "举",
          "pos": "动词",
          "gloss": "施行"
        },
        {
          "surface": "先王",
          "pos": "名词",
          "gloss": "前代君王"
        },
        {
          "surface": "兴利除弊",
          "pos": "固定结构",
          "gloss": "兴办好事，除去弊端"
        },
        {
          "surface": "生事",
          "pos": "动词",
          "gloss": "惹是生非"
        }
      ]
    },
    {
      "id": "dazheng-008",
      "order": 8,
      "text": "为天下理财，不为征利。",
      "translation": "替天下管理财政，不能算是与民争利。",
      "tokens": [
        {
          "surface": "为",
          "pos": "介词",
          "gloss": "替，给"
        },
        {
          "surface": "理财",
          "pos": "动词",
          "gloss": "管理财政"
        },
        {
          "surface": "征利",
          "pos": "动词",
          "gloss": "与民争利"
        }
      ]
    },
    {
      "id": "dazheng-009",
      "order": 9,
      "text": "辟邪说，难壬人，不为拒谏。",
      "translation": "抨击不正确的言论，反驳巧言谄媚的人，不能算是拒绝接受意见。",
      "tokens": [
        {
          "surface": "辟",
          "pos": "动词",
          "gloss": "抨击，驳斥"
        },
        {
          "surface": "邪说",
          "pos": "名词",
          "gloss": "不正确的言论"
        },
        {
          "surface": "难",
          "pos": "动词",
          "gloss": "反驳，诘难"
        },
        {
          "surface": "壬人",
          "pos": "名词",
          "gloss": "巧言谄媚的人"
        },
        {
          "surface": "拒谏",
          "pos": "动词",
          "gloss": "拒绝劝告"
        }
      ]
    },
    {
      "id": "dazheng-010",
      "order": 10,
      "text": "至于怨诽之多，则固前知其如此也。",
      "translation": "至于怨恨诽谤这么多，那是我本来就预先知道会这样的。",
      "tokens": [
        {
          "surface": "怨诽",
          "pos": "名词",
          "gloss": "怨恨诽谤"
        },
        {
          "surface": "固",
          "pos": "副词",
          "gloss": "本来"
        },
        {
          "surface": "前知",
          "pos": "动词",
          "gloss": "预先知道"
        }
      ]
    },
    {
      "id": "dazheng-011",
      "order": 11,
      "text": "人习于苟且非一日，士大夫多以不恤国事、同俗自媚于众为善，上乃欲变此，而某不量敌之众寡，欲出力助上以抗之，则众何为而不汹汹然？",
      "translation": "人们习惯于得过且过不是一天了，士大夫大多把不关心国家大事、附和世俗、向众人献媚当作好事，皇上于是想改变这种风气，而我不估量反对者的多少，想出力帮助皇上抵抗他们，那么众人怎么会不吵吵嚷嚷呢？",
      "tokens": [
        {
          "surface": "苟且",
          "pos": "动词",
          "gloss": "得过且过"
        },
        {
          "surface": "不恤",
          "pos": "动词",
          "gloss": "不关心"
        },
        {
          "surface": "同俗",
          "pos": "动词",
          "gloss": "附和世俗"
        },
        {
          "surface": "自媚",
          "pos": "动词",
          "gloss": "自我献媚"
        },
        {
          "surface": "量",
          "pos": "动词",
          "gloss": "估量"
        },
        {
          "surface": "汹汹然",
          "pos": "形容词",
          "gloss": "吵嚷喧扰的样子"
        }
      ]
    },
    {
      "id": "dazheng-012",
      "order": 12,
      "text": "盘庚之迁，胥怨者民也，非特朝廷士大夫而已。",
      "translation": "盘庚迁都，怨恨他的是百姓，不只是朝廷的士大夫而已。",
      "tokens": [
        {
          "surface": "盘庚",
          "pos": "名词",
          "gloss": "商代君主"
        },
        {
          "surface": "迁",
          "pos": "动词",
          "gloss": "迁都"
        },
        {
          "surface": "胥",
          "pos": "副词",
          "gloss": "都，皆"
        },
        {
          "surface": "非特",
          "pos": "连词",
          "gloss": "不只是"
        },
        {
          "surface": "而已",
          "pos": "语气助词",
          "gloss": "罢了"
        }
      ]
    },
    {
      "id": "dazheng-013",
      "order": 13,
      "text": "盘庚不为怨者故改其度，度义而后动，是而不见可悔故也。",
      "translation": "盘庚不因为有人怨恨的缘故就改变自己的计划，考虑到这样做是适宜的然后行动，认为这样做是对的、因而看不出有什么可后悔的缘故。",
      "tokens": [
        {
          "surface": "为",
          "pos": "介词",
          "gloss": "因为"
        },
        {
          "surface": "改其度",
          "pos": "动词",
          "gloss": "改变他的计划"
        },
        {
          "surface": "度义",
          "pos": "动词",
          "gloss": "考虑这样做是否适宜"
        },
        {
          "surface": "是",
          "pos": "动词",
          "gloss": "认为对"
        },
        {
          "surface": "可悔",
          "pos": "动词",
          "gloss": "可后悔"
        }
      ]
    },
    {
      "id": "dazheng-014",
      "order": 14,
      "text": "如君实责我以在位久，未能助上大有为，以膏泽斯民，则某知罪矣。",
      "translation": "如果君实责备我居高位已久，没有能帮助皇上大有作为，来使百姓得到恩惠，那么我承认自己有过错。",
      "tokens": [
        {
          "surface": "责",
          "pos": "动词",
          "gloss": "责备"
        },
        {
          "surface": "在位久",
          "pos": "动词",
          "gloss": "居高位时间久"
        },
        {
          "surface": "膏泽",
          "pos": "动词",
          "gloss": "施加恩惠"
        },
        {
          "surface": "斯民",
          "pos": "名词",
          "gloss": "这些百姓"
        },
        {
          "surface": "知罪",
          "pos": "动词",
          "gloss": "承认过错"
        }
      ]
    },
    {
      "id": "dazheng-015",
      "order": 15,
      "text": "如曰今日当一切不事事，守前所为而已，则非某之所敢知。",
      "translation": "如果说现在应当什么事都不做，只是守着前人的做法罢了，那就不是我敢领教的。",
      "tokens": [
        {
          "surface": "事事",
          "pos": "动词",
          "gloss": "做事"
        },
        {
          "surface": "守前所为",
          "pos": "动词",
          "gloss": "守着前人的做法"
        },
        {
          "surface": "而已",
          "pos": "语气助词",
          "gloss": "罢了"
        },
        {
          "surface": "敢知",
          "pos": "动词",
          "gloss": "敢领教，敢知道"
        }
      ]
    },
    {
      "id": "dazheng-016",
      "order": 16,
      "text": "无由会晤，不任区区向往之至。",
      "translation": "没有缘由见面，内心不胜仰慕到极点。",
      "tokens": [
        {
          "surface": "无由",
          "pos": "动词",
          "gloss": "没有缘由"
        },
        {
          "surface": "会晤",
          "pos": "动词",
          "gloss": "见面"
        },
        {
          "surface": "不任",
          "pos": "动词",
          "gloss": "不胜"
        },
        {
          "surface": "区区",
          "pos": "形容词",
          "gloss": "诚挚，谦指自己"
        },
        {
          "surface": "向往之至",
          "pos": "固定结构",
          "gloss": "仰慕到极点"
        }
      ]
    }
  ]
}
