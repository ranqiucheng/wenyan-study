{
  "id": "shishuo",
  "title": "师说",
  "author": "韩愈",
  "source": "《昌黎先生集》",
  "volume": "必修上册",
  "tags": [
    "课标",
    "议论"
  ],
  "reviewed": true,
  "summary": "论述从师学习的必要性与择师标准，批判士大夫耻学于师的风气。",
  "sentences": [
    {
      "id": "shishuo-001",
      "order": 1,
      "text": "古之学者必有师。",
      "translation": "古代求学的人一定要有老师。",
      "tokens": [
        {
          "surface": "之",
          "pos": "助词",
          "gloss": "用在定语和中心语之间，的"
        },
        {
          "surface": "学者",
          "pos": "名词",
          "gloss": "求学的人（古今异义）"
        },
        {
          "surface": "必",
          "pos": "副词",
          "gloss": "一定"
        },
        {
          "surface": "师",
          "pos": "名词",
          "gloss": "老师"
        }
      ]
    },
    {
      "id": "shishuo-002",
      "order": 2,
      "text": "师者，所以传道受业解惑也。",
      "translation": "老师，是用来传授道理、教授学业、解答疑难问题的人。",
      "tokens": [
        {
          "surface": "者",
          "pos": "助词",
          "gloss": "表停顿，与“也”构成判断句"
        },
        {
          "surface": "所以",
          "pos": "固定结构",
          "gloss": "用来……的"
        },
        {
          "surface": "道",
          "pos": "名词",
          "gloss": "道理，指儒家之道"
        },
        {
          "surface": "受",
          "pos": "动词",
          "gloss": "通“授”，传授"
        },
        {
          "surface": "业",
          "pos": "名词",
          "gloss": "学业"
        },
        {
          "surface": "惑",
          "pos": "名词",
          "gloss": "疑难问题"
        }
      ]
    },
    {
      "id": "shishuo-003",
      "order": 3,
      "text": "人非生而知之者，孰能无惑？",
      "translation": "人不是生下来就懂得道理的，谁能没有疑惑呢？",
      "tokens": [
        {
          "surface": "非",
          "pos": "动词",
          "gloss": "不是"
        },
        {
          "surface": "而",
          "pos": "连词",
          "gloss": "表承接，就"
        },
        {
          "surface": "知",
          "pos": "动词",
          "gloss": "懂得"
        },
        {
          "surface": "之",
          "pos": "代词",
          "gloss": "指道理"
        },
        {
          "surface": "孰",
          "pos": "代词",
          "gloss": "谁"
        },
        {
          "surface": "惑",
          "pos": "名词",
          "gloss": "疑惑"
        }
      ]
    },
    {
      "id": "shishuo-004",
      "order": 4,
      "text": "惑而不从师，其为惑也，终不解矣。",
      "translation": "有了疑惑却不跟从老师学习，那些成为疑难的问题，最终也不能解决了。",
      "tokens": [
        {
          "surface": "惑",
          "pos": "名词",
          "gloss": "疑难问题"
        },
        {
          "surface": "而",
          "pos": "连词",
          "gloss": "表转折，却"
        },
        {
          "surface": "从师",
          "pos": "动词",
          "gloss": "跟从老师学习"
        },
        {
          "surface": "其",
          "pos": "代词",
          "gloss": "那些"
        },
        {
          "surface": "为",
          "pos": "动词",
          "gloss": "成为"
        },
        {
          "surface": "终",
          "pos": "副词",
          "gloss": "最终"
        },
        {
          "surface": "解",
          "pos": "动词",
          "gloss": "解决，理解"
        }
      ]
    },
    {
      "id": "shishuo-005",
      "order": 5,
      "text": "生乎吾前，其闻道也固先乎吾，吾从而师之；生乎吾后，其闻道也亦先乎吾，吾从而师之。",
      "translation": "出生在我前面的人，他懂得道理本来就比我早，我跟从他学习，把他当作老师；出生在我后面的人，他懂得道理如果也比我早，我也跟从他学习，把他当作老师。",
      "tokens": [
        {
          "surface": "乎",
          "pos": "介词",
          "gloss": "相当于“于”，在"
        },
        {
          "surface": "闻道",
          "pos": "动词",
          "gloss": "懂得道理"
        },
        {
          "surface": "固",
          "pos": "副词",
          "gloss": "本来"
        },
        {
          "surface": "先乎吾",
          "pos": "固定结构",
          "gloss": "比我早"
        },
        {
          "surface": "从而",
          "pos": "连词",
          "gloss": "跟从他并且"
        },
        {
          "surface": "师之",
          "pos": "动词",
          "gloss": "以之为师（意动用法）"
        },
        {
          "surface": "亦",
          "pos": "副词",
          "gloss": "也"
        }
      ]
    },
    {
      "id": "shishuo-006",
      "order": 6,
      "text": "吾师道也，夫庸知其年之先后生于吾乎？",
      "translation": "我是向他学习道理的，哪里需要知道他的年龄比我大还是比我小呢？",
      "tokens": [
        {
          "surface": "师道",
          "pos": "动词",
          "gloss": "学习道理"
        },
        {
          "surface": "夫",
          "pos": "助词",
          "gloss": "句首发语词，无实义"
        },
        {
          "surface": "庸",
          "pos": "副词",
          "gloss": "岂，哪里"
        },
        {
          "surface": "其",
          "pos": "代词",
          "gloss": "他的"
        },
        {
          "surface": "年",
          "pos": "名词",
          "gloss": "年龄"
        },
        {
          "surface": "先后",
          "pos": "名词",
          "gloss": "谁先谁后"
        },
        {
          "surface": "乎",
          "pos": "语气助词",
          "gloss": "表疑问，呢"
        }
      ]
    },
    {
      "id": "shishuo-007",
      "order": 7,
      "text": "是故无贵无贱，无长无少，道之所存，师之所存也。",
      "translation": "因此无论地位高低贵贱，无论年龄大小，道理存在的地方，就是老师存在的地方。",
      "tokens": [
        {
          "surface": "是故",
          "pos": "连词",
          "gloss": "因此"
        },
        {
          "surface": "无",
          "pos": "动词",
          "gloss": "无论"
        },
        {
          "surface": "贵",
          "pos": "形容词",
          "gloss": "地位高"
        },
        {
          "surface": "贱",
          "pos": "形容词",
          "gloss": "地位低"
        },
        {
          "surface": "长",
          "pos": "形容词",
          "gloss": "年长"
        },
        {
          "surface": "少",
          "pos": "形容词",
          "gloss": "年轻"
        },
        {
          "surface": "所存",
          "pos": "名词",
          "gloss": "存在的地方"
        }
      ]
    },
    {
      "id": "shishuo-008",
      "order": 8,
      "text": "嗟乎！师道之不传也久矣！",
      "translation": "唉！从师学习的风尚不流传已经很久了！",
      "tokens": [
        {
          "surface": "嗟乎",
          "pos": "叹词",
          "gloss": "唉，表感叹"
        },
        {
          "surface": "师道",
          "pos": "名词",
          "gloss": "从师学习的风尚"
        },
        {
          "surface": "之",
          "pos": "助词",
          "gloss": "取消句子独立性"
        },
        {
          "surface": "传",
          "pos": "动词",
          "gloss": "流传"
        },
        {
          "surface": "久",
          "pos": "形容词",
          "gloss": "长久"
        },
        {
          "surface": "矣",
          "pos": "语气助词",
          "gloss": "了"
        }
      ]
    },
    {
      "id": "shishuo-009",
      "order": 9,
      "text": "欲人之无惑也难矣！",
      "translation": "想要人们没有疑惑就很难了！",
      "tokens": [
        {
          "surface": "欲",
          "pos": "动词",
          "gloss": "想要"
        },
        {
          "surface": "之",
          "pos": "助词",
          "gloss": "取消句子独立性"
        },
        {
          "surface": "无惑",
          "pos": "动词",
          "gloss": "没有疑惑"
        },
        {
          "surface": "也",
          "pos": "语气助词",
          "gloss": "句中表停顿"
        },
        {
          "surface": "难",
          "pos": "形容词",
          "gloss": "困难"
        },
        {
          "surface": "矣",
          "pos": "语气助词",
          "gloss": "了"
        }
      ]
    },
    {
      "id": "shishuo-010",
      "order": 10,
      "text": "古之圣人，其出人也远矣，犹且从师而问焉；今之众人，其下圣人也亦远矣，而耻学于师。",
      "translation": "古代的圣人，他们超出一般人很远了，尚且跟从老师请教；如今的一般人，他们低于圣人也太远了，却以向老师学习为耻。",
      "tokens": [
        {
          "surface": "出人",
          "pos": "动词",
          "gloss": "超出一般人"
        },
        {
          "surface": "犹且",
          "pos": "副词",
          "gloss": "尚且，还"
        },
        {
          "surface": "从师",
          "pos": "动词",
          "gloss": "跟从老师"
        },
        {
          "surface": "焉",
          "pos": "兼词",
          "gloss": "于之，向他"
        },
        {
          "surface": "众人",
          "pos": "名词",
          "gloss": "一般人"
        },
        {
          "surface": "下",
          "pos": "动词",
          "gloss": "低于"
        },
        {
          "surface": "耻",
          "pos": "动词",
          "gloss": "以……为耻（意动用法）"
        },
        {
          "surface": "于",
          "pos": "介词",
          "gloss": "向"
        }
      ]
    },
    {
      "id": "shishuo-011",
      "order": 11,
      "text": "是故圣益圣，愚益愚。",
      "translation": "因此圣人更加圣明，愚人更加愚昧。",
      "tokens": [
        {
          "surface": "是故",
          "pos": "连词",
          "gloss": "因此"
        },
        {
          "surface": "圣",
          "pos": "名词",
          "gloss": "圣人"
        },
        {
          "surface": "益",
          "pos": "副词",
          "gloss": "更加"
        },
        {
          "surface": "圣",
          "pos": "形容词",
          "gloss": "圣明"
        },
        {
          "surface": "愚",
          "pos": "名词",
          "gloss": "愚人"
        },
        {
          "surface": "益",
          "pos": "副词",
          "gloss": "更加"
        },
        {
          "surface": "愚",
          "pos": "形容词",
          "gloss": "愚昧"
        }
      ]
    },
    {
      "id": "shishuo-012",
      "order": 12,
      "text": "圣人之所以为圣，愚人之所以为愚，其皆出于此乎？",
      "translation": "圣人成为圣人的原因，愚人成为愚人的原因，大概都出于这个道理吧？",
      "tokens": [
        {
          "surface": "之所以",
          "pos": "固定结构",
          "gloss": "……的原因"
        },
        {
          "surface": "为",
          "pos": "动词",
          "gloss": "成为"
        },
        {
          "surface": "之所以",
          "pos": "固定结构",
          "gloss": "……的原因"
        },
        {
          "surface": "其",
          "pos": "副词",
          "gloss": "大概，表推测"
        },
        {
          "surface": "皆",
          "pos": "副词",
          "gloss": "都"
        },
        {
          "surface": "出于",
          "pos": "动词",
          "gloss": "出自"
        },
        {
          "surface": "此",
          "pos": "代词",
          "gloss": "这，指上面说的道理"
        }
      ]
    },
    {
      "id": "shishuo-013",
      "order": 13,
      "text": "爱其子，择师而教之；于其身也，则耻师焉，惑矣。",
      "translation": "爱自己的孩子，选择老师来教他；对于他自己呢，却以跟从老师学习为耻，真是糊涂啊。",
      "tokens": [
        {
          "surface": "其",
          "pos": "代词",
          "gloss": "自己的"
        },
        {
          "surface": "择师",
          "pos": "动词",
          "gloss": "选择老师"
        },
        {
          "surface": "而",
          "pos": "连词",
          "gloss": "表顺承"
        },
        {
          "surface": "于",
          "pos": "介词",
          "gloss": "对于"
        },
        {
          "surface": "则",
          "pos": "副词",
          "gloss": "却"
        },
        {
          "surface": "耻师",
          "pos": "动词",
          "gloss": "以从师为耻（意动用法）"
        },
        {
          "surface": "惑",
          "pos": "形容词",
          "gloss": "糊涂"
        },
        {
          "surface": "矣",
          "pos": "语气助词",
          "gloss": "了"
        }
      ]
    },
    {
      "id": "shishuo-014",
      "order": 14,
      "text": "彼童子之师，授之书而习其句读者，非吾所谓传其道解其惑者也。",
      "translation": "那些孩子的老师，是教给孩子书本知识、让他学习断句的人，不是我所说的传授道理、解答疑惑的人。",
      "tokens": [
        {
          "surface": "彼",
          "pos": "代词",
          "gloss": "那些"
        },
        {
          "surface": "童子",
          "pos": "名词",
          "gloss": "孩子"
        },
        {
          "surface": "授之书",
          "pos": "动词",
          "gloss": "教给他书本知识"
        },
        {
          "surface": "句读",
          "pos": "名词",
          "gloss": "断句，文辞停顿处"
        },
        {
          "surface": "者",
          "pos": "助词",
          "gloss": "……的人"
        },
        {
          "surface": "非",
          "pos": "动词",
          "gloss": "不是"
        },
        {
          "surface": "所谓",
          "pos": "固定结构",
          "gloss": "所说的"
        },
        {
          "surface": "惑",
          "pos": "名词",
          "gloss": "疑惑"
        }
      ]
    },
    {
      "id": "shishuo-015",
      "order": 15,
      "text": "句读之不知，惑之不解，或师焉，或不焉，小学而大遗，吾未见其明也。",
      "translation": "不懂得断句，不能解决疑惑，有的向老师请教，有的却不问，小的方面学了，大的方面却丢弃了，我看不出他们高明在哪里。",
      "tokens": [
        {
          "surface": "句读",
          "pos": "名词",
          "gloss": "断句，文辞停顿处"
        },
        {
