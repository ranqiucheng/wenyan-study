          "gloss": "各种工匠"
        },
        {
          "surface": "耻",
          "pos": "动词",
          "gloss": "以……为耻（意动用法）"
        },
        {
          "surface": "相师",
          "pos": "动词",
          "gloss": "互相学习"
        }
      ]
    },
    {
      "id": "shishuo-017",
      "order": 17,
      "text": "士大夫之族，曰师曰弟子云者，则群聚而笑之。",
      "translation": "士大夫这类人，一说到“老师”“弟子”这样的话，就聚在一起嘲笑他。",
      "tokens": [
        {
          "surface": "士大夫",
          "pos": "名词",
