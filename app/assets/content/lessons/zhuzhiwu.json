          "gloss": "哪里"
        }
      ]
    },
    {
      "id": "zhuzhiwu-018",
      "order": 18,
      "text": "阙秦以利晋，唯君图之。",
      "translation": "侵损秦国来使晋国得利，希望您考虑这件事。",
      "tokens": [
        {
          "surface": "阙",
          "pos": "动词",
          "gloss": "侵损，削减"
        },
        {
          "surface": "利",
