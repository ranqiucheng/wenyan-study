        }
      ]
    },
    {
      "id": "zhuzhiwu-022",
      "order": 22,
      "text": "公曰：“不可。微夫人之力不及此。",
      "translation": "晋文公说：不行。如果没有那个人的力量，我不会有今天。",
      "tokens": [
        {
          "surface": "不可",
          "pos": "固定结构",
          "gloss": "不行"
        },
        {
          "surface": "微",
          "pos": "连词",
