          "gloss": "到达"
        }
      ]
    },
    {
      "id": "zhuzhiwu-023",
      "order": 23,
      "text": "因人之力而敝之，不仁；失其所与，不知；以乱易整，不武。",
      "translation": "依靠别人的力量却损害他，是不仁；失去自己的同盟者，是不明智；用混乱替代整齐，是不勇武。",
      "tokens": [
        {
          "surface": "因",
          "pos": "介词",
          "gloss": "依靠"
        },
        {
          "surface": "敝",
          "pos": "动词",
          "gloss": "损害"
        },
        {
          "surface": "所与",
          "pos": "名词",
          "gloss": "同盟者"
        },
        {
          "surface": "不知",
          "pos": "形容词",
          "gloss": "同“智”，明智"
        },
        {
          "surface": "易",
          "pos": "动词",
          "gloss": "替代"
        },
        {
          "surface": "整",
          "pos": "形容词",
          "gloss": "整齐"
        },
        {
          "surface": "武",
          "pos": "形容词",
          "gloss": "勇武"
        }
      ]
    },
