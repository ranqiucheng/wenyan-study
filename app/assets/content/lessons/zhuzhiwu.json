          "gloss": "考虑"
        }
      ]
    },
    {
      "id": "zhuzhiwu-019",
      "order": 19,
      "text": "秦伯说，与郑人盟。",
      "translation": "秦伯很高兴，与郑国人结盟。",
      "tokens": [
        {
          "surface": "说",
          "pos": "动词",
          "gloss": "同“悦”，高兴"
        },
        {
          "surface": "与",
