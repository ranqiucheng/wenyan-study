          "pos": "副词",
          "gloss": "于是"
        },
        {
          "surface": "还",
          "pos": "动词",
          "gloss": "撤军回国"
        }
      ]
    },
    {
      "id": "zhuzhiwu-021",
      "order": 21,
      "text": "子犯请击之。",
      "translation": "子犯请求攻击秦军。",
      "tokens": [
        {
          "surface": "请",
          "pos": "动词",
          "gloss": "请求"
        },
        {
          "surface": "击",
          "pos": "动词",
          "gloss": "攻击"
        },
        {
          "surface": "之",
