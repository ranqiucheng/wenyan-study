          "gloss": "已经"
        }
      ]
    },
    {
      "id": "zhuzhiwu-010",
      "order": 10,
      "text": "若亡郑而有益于君，敢以烦执事。",
      "translation": "如果使郑国灭亡对您有好处，那就冒昧地拿这件事麻烦您。",
      "tokens": [
        {
          "surface": "若",
          "pos": "连词",
          "gloss": "如果"
        },
        {
          "surface": "亡",
          "pos": "动词",
          "gloss": "使……灭亡，使动"
        },
        {
          "surface": "而",
          "pos": "连词",
          "gloss": "表顺承"
        },
        {
          "surface": "益",
          "pos": "名词",
          "gloss": "好处"
        },
        {
          "surface": "敢",
          "pos": "副词",
          "gloss": "冒昧地"
        },
        {
          "surface": "执事",
          "pos": "名词",
          "gloss": "办事的人，指秦伯"
        }
      ]
    },
    {
      "id": "zhuzhiwu-011",
      "order": 11,
      "text": "越国以鄙远，君知其难也。",
      "translation": "越过晋国把远方的郑国作为秦国的边邑，您知道那是很难的。",
      "tokens": [
        {
          "surface": "越",
          "pos": "动词",
          "gloss": "越过"
        },
        {
          "surface": "以",
          "pos": "连词",
          "gloss": "来"
        },
        {
          "surface": "鄙",
          "pos": "动词",
          "gloss": "把……当作边邑"
        },
