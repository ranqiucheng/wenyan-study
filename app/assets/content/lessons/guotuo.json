          "gloss": "使……繁衍"
        },
        {
          "surface": "安",
          "pos": "动词",
          "gloss": "使……安定"
        }
      ]
    },
    {
      "id": "guotuo-030",
      "order": 30,
      "text": "故病且怠。",
      "translation": "所以困苦并且疲倦。",
      "tokens": [
