{
  "id": "liuguolun",
  "title": "六国论",
  "author": "苏洵",
  "source": "《嘉祐集》",
  "volume": "必修下册",
  "tags": [
    "课标",
    "议论"
  ],
  "reviewed": true,
  "summary": "论述六国破灭，弊在赂秦，借古讽今，警示北宋为政者勿以赂求安。",
  "sentences": [
    {
      "id": "liuguolun-001",
      "order": 1,
      "text": "六国破灭，非兵不利，战不善，弊在赂秦。",
      "translation": "六国灭亡，不是武器不锋利，仗打得不好，弊病在于贿赂秦国。",
      "tokens": [
        {
          "surface": "破灭",
          "pos": "动词",
          "gloss": "灭亡"
        },
        {
          "surface": "兵",
          "pos": "名词",
          "gloss": "兵器"
        },
        {
          "surface": "不利",
          "pos": "形容词",
          "gloss": "不锋利"
        },
        {
          "surface": "战",
          "pos": "动词",
          "gloss": "作战"
        },
        {
          "surface": "弊",
          "pos": "名词",
          "gloss": "弊病"
        },
        {
          "surface": "赂",
          "pos": "动词",
          "gloss": "贿赂"
        }
      ]
    },
    {
      "id": "liuguolun-002",
      "order": 2,
      "text": "赂秦而力亏，破灭之道也。",
      "translation": "贿赂秦国，国力就亏损，这是灭亡的原因。",
      "tokens": [
        {
          "surface": "赂",
          "pos": "动词",
          "gloss": "贿赂"
        },
        {
          "surface": "而",
          "pos": "连词",
          "gloss": "因而，表因果"
        },
        {
          "surface": "亏",
          "pos": "动词",
          "gloss": "亏损"
        },
        {
          "surface": "道",
          "pos": "名词",
          "gloss": "原因"
        },
        {
          "surface": "也",
          "pos": "助词",
          "gloss": "表判断语气"
        }
      ]
    },
    {
      "id": "liuguolun-003",
      "order": 3,
      "text": "或曰：六国互丧，率赂秦耶？",
      "translation": "有人说：六国相继灭亡，全都是因为贿赂秦国吗？",
      "tokens": [
        {
          "surface": "或",
          "pos": "代词",
          "gloss": "有人"
        },
        {
          "surface": "互丧",
          "pos": "动词",
          "gloss": "相继灭亡"
        },
        {
          "surface": "率",
          "pos": "副词",
          "gloss": "一概，全都"
        },
        {
          "surface": "耶",
          "pos": "助词",
          "gloss": "疑问语气词"
        }
      ]
    },
    {
      "id": "liuguolun-004",
      "order": 4,
      "text": "曰：不赂者以赂者丧。盖失强援，不能独完。",
      "translation": "回答说：不贿赂秦国的国家因为贿赂秦国的国家而灭亡。因为失去了强大的援助，不能独自保全。",
      "tokens": [
        {
          "surface": "以",
          "pos": "介词",
          "gloss": "因为"
        },
        {
          "surface": "盖",
          "pos": "连词",
          "gloss": "因为，表原因"
        },
        {
          "surface": "强援",
          "pos": "名词",
          "gloss": "强大的援助"
        },
        {
          "surface": "独完",
          "pos": "动词",
          "gloss": "独自保全"
        }
      ]
    },
    {
      "id": "liuguolun-005",
      "order": 5,
      "text": "故曰：弊在赂秦也。",
      "translation": "所以说：弊病在于贿赂秦国。",
      "tokens": [
        {
          "surface": "故",
          "pos": "连词",
          "gloss": "所以"
        },
        {
          "surface": "弊",
          "pos": "名词",
          "gloss": "弊病"
        },
        {
          "surface": "在",
          "pos": "动词",
          "gloss": "在于"
        },
        {
          "surface": "也",
          "pos": "助词",
          "gloss": "表判断语气"
        }
      ]
    },
    {
      "id": "liuguolun-006",
      "order": 6,
      "text": "秦以攻取之外，小则获邑，大则得城。",
      "translation": "秦国除了凭攻战夺取土地之外，小的方面得到城镇，大的方面得到城池。",
      "tokens": [
        {
          "surface": "以",
          "pos": "介词",
          "gloss": "凭"
        },
        {
          "surface": "攻取",
          "pos": "动词",
          "gloss": "攻战夺取"
        },
        {
          "surface": "小",
          "pos": "形容词",
          "gloss": "小的方面，形作名"
        },
        {
          "surface": "邑",
          "pos": "名词",
          "gloss": "城镇"
        },
        {
          "surface": "大",
          "pos": "形容词",
          "gloss": "大的方面，形作名"
        },
        {
          "surface": "城",
          "pos": "名词",
          "gloss": "城池"
        }
      ]
    },
    {
      "id": "liuguolun-007",
      "order": 7,
      "text": "较秦之所得，与战胜而得者，其实百倍；诸侯之所亡，与战败而亡者，其实亦百倍。",
      "translation": "比较秦国受贿所得的土地，与战胜而得的土地，那实际上有一百倍；诸侯行贿丧失的土地，与战败而丧失的土地，那实际上也有一百倍。",
      "tokens": [
        {
          "surface": "较",
          "pos": "动词",
          "gloss": "比较"
        },
        {
          "surface": "所得",
          "pos": "固定结构",
          "gloss": "得到的土地"
        },
        {
          "surface": "其实",
          "pos": "名词",
          "gloss": "那实际情况，古今异义"
        },
        {
          "surface": "百倍",
          "pos": "数量词",
          "gloss": "相差一百倍"
        },
        {
          "surface": "所亡",
          "pos": "固定结构",
          "gloss": "丧失的土地"
        }
      ]
    },
    {
      "id": "liuguolun-008",
      "order": 8,
      "text": "则秦之所大欲，诸侯之所大患，固不在战矣。",
      "translation": "那么秦国最大的欲望，诸侯最大的祸患，本来就不在战争上。",
      "tokens": [
        {
          "surface": "则",
          "pos": "连词",
          "gloss": "那么"
        },
        {
          "surface": "大欲",
          "pos": "名词",
          "gloss": "最大的欲望"
        },
        {
          "surface": "患",
          "pos": "名词",
          "gloss": "祸患"
        },
        {
          "surface": "固",
          "pos": "副词",
          "gloss": "本来"
        },
        {
          "surface": "矣",
          "pos": "助词",
          "gloss": "表陈述语气"
        }
      ]
    },
    {
      "id": "liuguolun-009",
      "order": 9,
      "text": "思厥先祖父，暴霜露，斩荆棘，以有尺寸之地。",
      "translation": "想想他们的祖辈父辈，冒着霜露，砍伐荆棘，才有了很少的一点土地。",
      "tokens": [
        {
          "surface": "厥",
          "pos": "代词",
          "gloss": "他们的"
        },
        {
          "surface": "先祖父",
          "pos": "名词",
          "gloss": "已故的祖辈、父辈"
        },
        {
          "surface": "暴",
          "pos": "动词",
          "gloss": "同“曝”，冒着"
        },
        {
          "surface": "斩",
          "pos": "动词",
          "gloss": "砍伐"
        },
        {
          "surface": "以",
          "pos": "连词",
          "gloss": "才，表结果"
        }
      ]
    },
    {
      "id": "liuguolun-010",
      "order": 10,
      "text": "子孙视之不甚惜，举以予人，如弃草芥。",
      "translation": "子孙对待这些土地很不爱惜，拿来送给别人，像丢弃小草一样。",
      "tokens": [
        {
          "surface": "视",
          "pos": "动词",
          "gloss": "看待"
        },
        {
          "surface": "之",
          "pos": "代词",
          "gloss": "指土地"
        },
        {
          "surface": "甚",
          "pos": "副词",
          "gloss": "很"
        },
        {
          "surface": "举",
          "pos": "动词",
          "gloss": "拿"
        },
        {
          "surface": "以",
          "pos": "连词",
          "gloss": "来，表目的"
        },
        {
          "surface": "予",
          "pos": "动词",
          "gloss": "给"
        },
        {
          "surface": "草芥",
          "pos": "名词",
          "gloss": "小草，喻轻微之物"
        }
      ]
    },
    {
      "id": "liuguolun-011",
      "order": 11,
      "text": "今日割五城，明日割十城，然后得一夕安寝。",
      "translation": "今天割让五座城，明天割让十座城，这样以后才能得到一夜的安稳觉。",
      "tokens": [
        {
          "surface": "割",
          "pos": "动词",
          "gloss": "割让"
        },
        {
          "surface": "然后",
          "pos": "连词",
          "gloss": "这样以后"
        },
        {
          "surface": "一夕",
          "pos": "数量词",
          "gloss": "一夜"
        },
        {
          "surface": "安寝",
          "pos": "动词",
          "gloss": "安稳睡觉"
        }
      ]
    },
    {
      "id": "liuguolun-012",
      "order": 12,
      "text": "起视四境，而秦兵又至矣。",
      "translation": "第二天起来看看四周边境，秦国的军队又到了。",
      "tokens": [
        {
          "surface": "起",
          "pos": "动词",
          "gloss": "起身"
        },
        {
          "surface": "四境",
          "pos": "名词",
          "gloss": "四周边境"
        },
        {
          "surface": "而",
          "pos": "连词",
          "gloss": "却"
        },
        {
          "surface": "又",
          "pos": "副词",
          "gloss": "再一次"
        },
        {
          "surface": "至",
          "pos": "动词",
          "gloss": "到来"
        }
      ]
    },
    {
      "id": "liuguolun-013",
      "order": 13,
      "text": "然则诸侯之地有限，暴秦之欲无厌，奉之弥繁，侵之愈急。",
      "translation": "既然这样，那么诸侯的土地有限，强暴的秦国的欲望没有满足的时候，送给它的越多，它侵犯诸侯就越急迫。",
      "tokens": [
        {
          "surface": "然则",
          "pos": "连词",
          "gloss": "既然这样，那么"
        },
        {
          "surface": "厌",
          "pos": "动词",
          "gloss": "同“餍”，满足"
        },
        {
          "surface": "奉",
          "pos": "动词",
          "gloss": "送上，献给"
        },
        {
          "surface": "弥",
          "pos": "副词",
          "gloss": "更加"
        },
        {
          "surface": "繁",
          "pos": "形容词",
          "gloss": "多"
        },
        {
          "surface": "侵",
          "pos": "动词",
          "gloss": "侵犯"
        },
        {
          "surface": "愈",
          "pos": "副词",
          "gloss": "更加"
        }
      ]
    },
    {
      "id": "liuguolun-014",
      "order": 14,
      "text": "故不战而强弱胜负已判矣。",
      "translation": "所以不用作战，强弱胜负就已经分清了。",
      "tokens": [
        {
          "surface": "故",
          "pos": "连词",
          "gloss": "所以"
        },
        {
          "surface": "判",
          "pos": "动词",
          "gloss": "分清，决定"
        },
        {
          "surface": "矣",
          "pos": "助词",
          "gloss": "表陈述语气"
        }
      ]
    },
    {
      "id": "liuguolun-015",
      "order": 15,
      "text": "至于颠覆，理固宜然。",
      "translation": "以至于灭亡，按道理本来就该这样。",
      "tokens": [
        {
          "surface": "至于",
          "pos": "连词",
          "gloss": "表示发展到某种程度"
        },
        {
          "surface": "颠覆",
          "pos": "动词",
          "gloss": "灭亡"
        },
        {
          "surface": "理",
          "pos": "名词",
          "gloss": "按道理"
        },
        {
          "surface": "固",
          "pos": "副词",
          "gloss": "本来"
        },
        {
          "surface": "宜",
          "pos": "动词",
          "gloss": "应该"
        },
        {
          "surface": "然",
          "pos": "代词",
          "gloss": "这样"
        }
      ]
    },
    {
      "id": "liuguolun-016",
      "order": 16,
      "text": "古人云：“以地事秦，犹抱薪救火，薪不尽，火不灭。”",
      "translation": "古人说：拿土地侍奉秦国，就像抱着柴草去救火，柴草不烧完，火就不会熄灭。",
      "tokens": [
        {
          "surface": "云",
          "pos": "动词",
          "gloss": "说"
        },
        {
          "surface": "以",
          "pos": "介词",
          "gloss": "拿"
        },
        {
          "surface": "事",
          "pos": "动词",
          "gloss": "侍奉"
        },
        {
          "surface": "犹",
          "pos": "动词",
          "gloss": "好像"
        },
        {
          "surface": "薪",
          "pos": "名词",
          "gloss": "柴草"
        },
        {
          "surface": "尽",
          "pos": "动词",
          "gloss": "烧完"
        },
        {
          "surface": "灭",
          "pos": "动词",
          "gloss": "熄灭"
        }
      ]
    },
    {
      "id": "liuguolun-017",
      "order": 17,
      "text": "此言得之。",
      "translation": "这话说对了。",
      "tokens": [
        {
          "surface": "此言",
          "pos": "代词",
          "gloss": "这话"
        },
        {
          "surface": "得",
          "pos": "动词",
          "gloss": "适宜，得当"
        },
        {
          "surface": "之",
          "pos": "代词",
          "gloss": "指上文的道理"
        }
      ]
    },
    {
      "id": "liuguolun-018",
      "order": 18,
      "text": "齐人未尝赂秦，终继五国迁灭，何哉？",
      "translation": "齐国人不曾贿赂秦国，最终也随着五国灭亡了，为什么呢？",
      "tokens": [
        {
          "surface": "未尝",
          "pos": "副词",
          "gloss": "不曾"
        },
        {
          "surface": "终",
          "pos": "副词",
          "gloss": "最终"
        },
        {
          "surface": "继",
          "pos": "动词",
          "gloss": "跟着"
        },
        {
          "surface": "迁灭",
          "pos": "动词",
          "gloss": "灭亡"
        },
        {
          "surface": "何哉",
          "pos": "固定结构",
          "gloss": "为什么呢"
        }
      ]
    },
    {
      "id": "liuguolun-019",
      "order": 19,
      "text": "与嬴而不助五国也。",
      "translation": "是因为它亲附秦国而不帮助五国啊。",
      "tokens": [
        {
          "surface": "与",
          "pos": "动词",
          "gloss": "亲附，结交"
        },
        {
          "surface": "嬴",
          "pos": "名词",
          "gloss": "秦国国君的姓，指秦国"
        },
        {
          "surface": "而",
          "pos": "连词",
          "gloss": "却"
        }
      ]
    },
    {
      "id": "liuguolun-020",
      "order": 20,
      "text": "五国既丧，齐亦不免矣。",
      "translation": "五国已经灭亡，齐国也不能幸免了。",
      "tokens": [
        {
          "surface": "既",
          "pos": "副词",
          "gloss": "已经"
        },
        {
          "surface": "丧",
          "pos": "动词",
          "gloss": "灭亡"
        },
        {
          "surface": "亦",
          "pos": "副词",
          "gloss": "也"
        },
        {
          "surface": "免",
          "pos": "动词",
          "gloss": "幸免"
        }
      ]
    },
    {
      "id": "liuguolun-021",
      "order": 21,
      "text": "燕赵之君，始有远略，能守其土，义不赂秦。",
      "translation": "燕国、赵国的君主，起初有长远的谋略，能够守住他们的国土，坚持正义而不贿赂秦国。",
      "tokens": [
        {
          "surface": "始",
          "pos": "副词",
          "gloss": "起初"
        },
        {
          "surface": "远略",
          "pos": "名词",
          "gloss": "长远的谋略"
        },
        {
          "surface": "守",
          "pos": "动词",
          "gloss": "守卫"
        },
        {
          "surface": "义",
          "pos": "名词",
          "gloss": "坚持正义，名作状"
        },
        {
          "surface": "赂",
          "pos": "动词",
          "gloss": "贿赂"
        }
      ]
    },
    {
      "id": "liuguolun-022",
      "order": 22,
      "text": "是故燕虽小国而后亡，斯用兵之效也。",
      "translation": "因此燕国虽然是小国却最后灭亡，这就是用兵抵抗的效果。",
      "tokens": [
        {
          "surface": "是故",
          "pos": "连词",
          "gloss": "因此"
        },
        {
          "surface": "虽",
          "pos": "连词",
          "gloss": "虽然"
        },
        {
          "surface": "后亡",
          "pos": "动词",
          "gloss": "最后灭亡"
        },
        {
          "surface": "斯",
          "pos": "代词",
          "gloss": "这"
        },
        {
          "surface": "用兵",
          "pos": "动词",
          "gloss": "用兵作战"
        },
        {
          "surface": "效",
          "pos": "名词",
          "gloss": "效果"
        }
      ]
    },
    {
      "id": "liuguolun-023",
      "order": 23,
      "text": "至丹以荆卿为计，始速祸焉。",
      "translation": "到了燕太子丹把荆轲刺秦王作为计策，才招致了祸患。",
      "tokens": [
        {
          "surface": "至",
          "pos": "动词",
          "gloss": "到了"
        },
        {
          "surface": "以",
          "pos": "介词",
          "gloss": "把"
        },
        {
          "surface": "为",
          "pos": "动词",
          "gloss": "作为"
        },
        {
          "surface": "计",
          "pos": "名词",
          "gloss": "计策"
        },
        {
          "surface": "始",
          "pos": "副词",
          "gloss": "才"
        },
        {
          "surface": "速",
          "pos": "动词",
          "gloss": "招致"
        },
        {
          "surface": "焉",
          "pos": "助词",
          "gloss": "句末语气词"
        }
      ]
    },
    {
      "id": "liuguolun-024",
      "order": 24,
      "text": "赵尝五战于秦，二败而三胜。",
      "translation": "赵国曾经跟秦国交战五次，两次失败三次胜利。",
      "tokens": [
        {
          "surface": "尝",
          "pos": "副词",
          "gloss": "曾经"
        },
        {
          "surface": "于",
          "pos": "介词",
          "gloss": "跟，引进对象"
        },
