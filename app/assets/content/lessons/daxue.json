          "gloss": "意念真诚"
        },
        {
          "surface": "心正",
          "pos": "动词",
          "gloss": "心意端正"
        },
        {
          "surface": "身修",
          "pos": "动词",
          "gloss": "自身修养好"
        },
        {
          "surface": "家齐",
          "pos": "动词",
          "gloss": "家族管理好"
        },
        {
          "surface": "国治",
          "pos": "动词",
          "gloss": "国家治理好"
        },
        {
          "surface": "天下平",
          "pos": "动词",
          "gloss": "天下太平"
        }
      ]
    },
    {
      "id": "daxue-006",
      "order": 6,
      "text": "自天子以至于庶人，壹是皆以修身为本。",
      "translation": "从天子一直到平民百姓，一概都以修养自身为根本。",
      "tokens": [
        {
          "surface": "自",
          "pos": "介词",
          "gloss": "从"
        },
        {
