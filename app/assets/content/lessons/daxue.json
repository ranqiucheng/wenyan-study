        }
      ]
    },
    {
      "id": "daxue-007",
      "order": 7,
      "text": "其本乱而末治者否矣。",
      "translation": "那根本紊乱而末节却治理得好的情况，是不会有的。",
      "tokens": [
        {
          "surface": "本",
          "pos": "名词",
          "gloss": "根本，指修身"
        },
        {
          "surface": "乱",
