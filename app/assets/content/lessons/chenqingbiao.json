          "gloss": "责备"
        },
        {
          "surface": "逋慢",
          "pos": "动词",
          "gloss": "逃避命令，态度傲慢"
        }
      ]
    },
    {
      "id": "chenqingbiao-015",
      "order": 15,
      "text": "郡县逼迫，催臣上道；州司临门，急于星火。",
      "translation": "郡县长官催逼，催促我上路；州官登门督促，比流星的光还急。",
      "tokens": [
        {
          "surface": "逼迫",
          "pos": "动词",
          "gloss": "催逼"
        },
        {
          "surface": "上道",
          "pos": "动词",
          "gloss": "上路"
        },
        {
          "surface": "州司",
          "pos": "名词",
          "gloss": "州官"
        },
        {
          "surface": "临门",
          "pos": "动词",
          "gloss": "登门"
        },
        {
          "surface": "于",
          "pos": "介词",
          "gloss": "比"
        },
        {
          "surface": "星火",
          "pos": "名词",
          "gloss": "流星的光"
        }
      ]
    },
    {
      "id": "chenqingbiao-016",
      "order": 16,
      "text": "臣欲奉诏奔驰，则刘病日笃；欲苟顺私情，则告诉不许。",
      "translation": "我想奉命急速赴任，但祖母的病一天天沉重；想暂且顺从私情，但申诉又不被允许。",
      "tokens": [
        {
          "surface": "奔驰",
          "pos": "动词",
          "gloss": "奔走效劳"
        },
        {
          "surface": "则",
          "pos": "连词",
          "gloss": "却"
        },
        {
          "surface": "日笃",
          "pos": "动词",
          "gloss": "一天天沉重"
        },
        {
          "surface": "苟",
          "pos": "副词",
          "gloss": "暂且"
        },
        {
          "surface": "告诉",
          "pos": "动词",
          "gloss": "申诉"
        },
        {
          "surface": "不许",
          "pos": "动词",
          "gloss": "不被允许"
        }
      ]
    },
    {
      "id": "chenqingbiao-017",
      "order": 17,
      "text": "臣之进退，实为狼狈。",
      "translation": "我的处境进退两难，实在狼狈。",
      "tokens": [
        {
          "surface": "之",
          "pos": "助词",
          "gloss": "取消句子独立性"
        },
        {
          "surface": "进退",
          "pos": "动词",
          "gloss": "进退两难"
        },
        {
          "surface": "狼狈",
          "pos": "形容词",
          "gloss": "困苦窘迫"
        }
      ]
    },
    {
      "id": "chenqingbiao-018",
      "order": 18,
      "text": "伏惟圣朝以孝治天下，凡在故老，犹蒙矜育，况臣孤苦，特为尤甚。",
      "translation": "我俯伏思量圣朝以孝道治理天下，凡是年老有功德的旧臣，尚且蒙受怜惜养育，何况我孤单困苦，更加厉害。",
      "tokens": [
        {
          "surface": "伏惟",
          "pos": "动词",
          "gloss": "俯伏思量，下对上的敬辞"
        },
        {
          "surface": "以",
          "pos": "介词",
          "gloss": "用"
        },
        {
          "surface": "故老",
          "pos": "名词",
          "gloss": "年老而有功德的旧臣"
        },
        {
          "surface": "犹",
          "pos": "副词",
          "gloss": "尚且"
        },
        {
          "surface": "蒙",
          "pos": "动词",
          "gloss": "蒙受"
        },
        {
          "surface": "矜育",
          "pos": "动词",
          "gloss": "怜惜养育"
        },
        {
          "surface": "况",
          "pos": "连词",
          "gloss": "何况"
        },
        {
          "surface": "尤甚",
          "pos": "形容词",
          "gloss": "更加厉害"
        }
      ]
    },
    {
      "id": "chenqingbiao-019",
      "order": 19,
      "text": "且臣少仕伪朝，历职郎署，本图宦达，不矜名节。",
      "translation": "况且我年轻时在伪朝做官，历任郎官衙署的职务，本来就希望仕途显达，并不看重名声节操。",
      "tokens": [
        {
          "surface": "仕",
          "pos": "动词",
          "gloss": "做官"
        },
        {
          "surface": "伪朝",
          "pos": "名词",
          "gloss": "指蜀汉"
        },
        {
          "surface": "历职",
          "pos": "动词",
          "gloss": "历任官职"
        },
        {
          "surface": "郎署",
          "pos": "名词",
          "gloss": "郎官的衙署"
        },
        {
          "surface": "图",
          "pos": "动词",
          "gloss": "希望"
        },
        {
          "surface": "宦达",
          "pos": "动词",
          "gloss": "仕途显达"
        },
        {
          "surface": "矜",
          "pos": "动词",
          "gloss": "看重"
        }
      ]
    },
    {
      "id": "chenqingbiao-020",
      "order": 20,
      "text": "今臣亡国贱俘，至微至陋，过蒙拔擢，宠命优渥，岂敢盘桓，有所希冀。",
      "translation": "如今我是亡国的卑贱俘虏，极其卑微浅陋，过分蒙受提拔，恩宠优厚，怎么敢徘徊不前，另有企求。",
      "tokens": [
        {
          "surface": "贱俘",
          "pos": "名词",
          "gloss": "卑贱的俘虏"
        },
        {
          "surface": "至",
          "pos": "副词",
          "gloss": "极其"
        },
        {
          "surface": "陋",
          "pos": "形容词",
          "gloss": "浅陋"
        },
        {
          "surface": "过",
          "pos": "副词",
          "gloss": "过分地"
        },
        {
          "surface": "拔擢",
          "pos": "动词",
          "gloss": "提拔"
        },
        {
          "surface": "优渥",
          "pos": "形容词",
          "gloss": "优厚"
        },
        {
          "surface": "盘桓",
          "pos": "动词",
          "gloss": "徘徊不前"
        },
        {
          "surface": "希冀",
          "pos": "动词",
          "gloss": "企求"
        }
      ]
    },
    {
      "id": "chenqingbiao-021",
      "order": 21,
      "text": "但以刘日薄西山，气息奄奄，人命危浅，朝不虑夕。",
      "translation": "只是因为祖母刘氏像太阳将落西山，气息微弱，生命垂危，朝不保夕。",
      "tokens": [
        {
          "surface": "但",
          "pos": "副词",
          "gloss": "只"
        },
        {
          "surface": "以",
          "pos": "介词",
          "gloss": "因为"
        },
        {
          "surface": "薄",
          "pos": "动词",
          "gloss": "迫近"
        },
        {
