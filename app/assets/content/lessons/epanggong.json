{
  "id": "epanggong",
  "title": "阿房宫赋",
  "author": "杜牧",
  "source": "《樊川文集》",
  "volume": "必修下册",
  "tags": [
    "课标",
    "赋"
  ],
  "reviewed": true,
  "summary": "借阿房宫的兴建与毁灭，揭露秦朝统治者骄奢亡国，告诫后人以史为鉴。",
  "sentences": [
    {
      "id": "epanggong-001",
      "order": 1,
      "text": "六王毕，四海一，蜀山兀，阿房出。",
      "translation": "六国灭亡了，天下统一了，蜀地的山林被砍伐光秃，阿房宫建成了。",
      "tokens": [
        {
          "surface": "六王",
          "pos": "名词",
          "gloss": "指六国君主"
        },
        {
          "surface": "毕",
          "pos": "动词",
          "gloss": "完结，指灭亡"
        },
        {
          "surface": "一",
          "pos": "动词",
          "gloss": "统一"
        },
        {
          "surface": "兀",
          "pos": "形容词",
          "gloss": "光秃"
        },
        {
          "surface": "出",
          "pos": "动词",
          "gloss": "出现，指建成"
        }
      ]
    },
    {
      "id": "epanggong-002",
      "order": 2,
      "text": "覆压三百余里，隔离天日。",
      "translation": "阿房宫覆盖三百多里，遮蔽了天空和太阳。",
      "tokens": [
        {
          "surface": "覆压",
          "pos": "动词",
          "gloss": "覆盖"
        },
        {
          "surface": "三百余里",
          "pos": "数量词",
          "gloss": "三百多里"
        },
        {
          "surface": "隔离",
          "pos": "动词",
          "gloss": "遮蔽"
        }
      ]
    },
    {
      "id": "epanggong-003",
      "order": 3,
      "text": "骊山北构而西折，直走咸阳。",
      "translation": "它从骊山向北构筑，再向西折去，一直通到咸阳。",
      "tokens": [
        {
          "surface": "北",
          "pos": "名词作状语",
          "gloss": "向北"
        },
        {
          "surface": "构",
          "pos": "动词",
          "gloss": "构筑"
        },
        {
          "surface": "而",
          "pos": "连词",
          "gloss": "表顺承"
        },
        {
          "surface": "西",
          "pos": "名词作状语",
          "gloss": "向西"
        },
        {
          "surface": "走",
          "pos": "动词",
          "gloss": "趋向，通到"
        }
      ]
    },
    {
      "id": "epanggong-004",
      "order": 4,
      "text": "二川溶溶，流入宫墙。",
      "translation": "渭水、樊川缓缓流淌，流进宫墙。",
      "tokens": [
        {
          "surface": "二川",
          "pos": "名词",
          "gloss": "指渭水和樊川"
        },
        {
          "surface": "溶溶",
          "pos": "形容词",
          "gloss": "河水流动的样子"
        },
        {
          "surface": "流入",
          "pos": "动词",
          "gloss": "流进"
        }
      ]
    },
    {
      "id": "epanggong-005",
      "order": 5,
      "text": "五步一楼，十步一阁；廊腰缦回，檐牙高啄；各抱地势，钩心斗角。",
      "translation": "五步一座楼，十步一个阁；走廊如腰带回环曲折，屋檐如鸟嘴高高翘起；各随地势而建，屋角钩连，屋心相斗。",
      "tokens": [
        {
          "surface": "廊腰",
          "pos": "名词",
          "gloss": "走廊的转折处"
        },
        {
          "surface": "缦回",
          "pos": "形容词",
          "gloss": "回环曲折"
        },
        {
          "surface": "檐牙",
          "pos": "名词",
          "gloss": "屋檐的尖角"
        },
        {
          "surface": "高啄",
          "pos": "动词",
          "gloss": "高高翘起如鸟嘴啄食"
        },
        {
          "surface": "抱",
          "pos": "动词",
          "gloss": "依凭"
        },
        {
          "surface": "钩心斗角",
          "pos": "固定结构",
          "gloss": "屋角钩连，屋心相斗"
        }
      ]
    },
    {
      "id": "epanggong-006",
      "order": 6,
      "text": "盘盘焉，囷囷焉，蜂房水涡，矗不知其几千万落。",
      "translation": "盘旋回环，屈曲交错，像蜂房、像水涡，高高耸立，不知有几千万座。",
      "tokens": [
        {
          "surface": "盘盘",
          "pos": "形容词",
          "gloss": "盘旋的样子"
        },
        {
          "surface": "焉",
          "pos": "助词",
          "gloss": "形容词词尾，相当于“然”"
        },
        {
          "surface": "囷囷",
          "pos": "形容词",
          "gloss": "屈曲的样子"
        },
        {
          "surface": "蜂房水涡",
          "pos": "名词作状语",
          "gloss": "像蜂房、像水涡"
        },
        {
          "surface": "矗",
          "pos": "动词",
          "gloss": "高耸"
        },
        {
          "surface": "落",
          "pos": "量词",
          "gloss": "座"
        }
      ]
    },
    {
      "id": "epanggong-007",
      "order": 7,
      "text": "长桥卧波，未云何龙？",
      "translation": "长桥横卧在水波上，没有云怎么出现了龙？",
      "tokens": [
        {
          "surface": "卧",
          "pos": "动词",
          "gloss": "横卧"
        },
        {
          "surface": "云",
          "pos": "名词作动词",
          "gloss": "出现云"
        },
        {
          "surface": "何",
          "pos": "代词",
          "gloss": "怎么"
        },
        {
          "surface": "龙",
          "pos": "名词作动词",
          "gloss": "出现龙"
        }
      ]
    },
    {
      "id": "epanggong-008",
      "order": 8,
      "text": "复道行空，不霁何虹？",
      "translation": "复道凌空而行，没有雨过天晴怎么出现了彩虹？",
      "tokens": [
        {
          "surface": "复道",
          "pos": "名词",
          "gloss": "楼阁间的空中通道"
        },
        {
          "surface": "霁",
          "pos": "动词",
          "gloss": "雨过天晴"
        },
        {
          "surface": "虹",
          "pos": "名词作动词",
          "gloss": "出现彩虹"
        }
      ]
    },
    {
      "id": "epanggong-009",
      "order": 9,
      "text": "高低冥迷，不知西东。",
      "translation": "高高低低的楼阁使人迷乱，分不清东西方向。",
      "tokens": [
        {
          "surface": "高低",
          "pos": "名词",
          "gloss": "高低错落的楼阁"
        },
        {
          "surface": "冥迷",
          "pos": "形容词",
          "gloss": "迷乱不清"
        },
        {
          "surface": "西东",
          "pos": "名词",
          "gloss": "东西方向"
        }
      ]
    },
    {
      "id": "epanggong-010",
      "order": 10,
      "text": "歌台暖响，春光融融；舞殿冷袖，风雨凄凄。",
      "translation": "歌台上乐声温暖，春意融融；舞殿里衣袖清冷，风雨凄凄。",
      "tokens": [
        {
          "surface": "歌台",
          "pos": "名词",
          "gloss": "唱歌的楼台"
        },
        {
          "surface": "暖响",
          "pos": "名词",
          "gloss": "温暖的声音"
        },
        {
          "surface": "春光融融",
          "pos": "固定结构",
          "gloss": "春意和暖"
        },
        {
          "surface": "舞殿",
          "pos": "名词",
          "gloss": "跳舞的宫殿"
        },
        {
          "surface": "冷袖",
          "pos": "名词",
          "gloss": "清冷的衣袖"
        },
        {
          "surface": "风雨凄凄",
          "pos": "固定结构",
          "gloss": "风雨凄凉"
        }
      ]
    },
    {
      "id": "epanggong-011",
      "order": 11,
      "text": "一日之内，一宫之间，而气候不齐。",
      "translation": "一天之内，一座宫殿之中，天气却不一样。",
      "tokens": [
        {
          "surface": "之",
          "pos": "助词",
          "gloss": "的"
        },
        {
          "surface": "而",
          "pos": "连词",
          "gloss": "表转折，却"
        },
        {
          "surface": "气候",
          "pos": "名词",
          "gloss": "天气"
        },
        {
          "surface": "不齐",
          "pos": "形容词",
          "gloss": "不一致"
        }
      ]
    },
    {
      "id": "epanggong-012",
      "order": 12,
      "text": "妃嫔媵嫱，王子皇孙，辞楼下殿，辇来于秦。",
      "translation": "六国的妃嫔媵嫱、王子皇孙，辞别楼阁、走下宫殿，乘辇车来到秦国。",
      "tokens": [
        {
          "surface": "妃嫔媵嫱",
          "pos": "名词",
          "gloss": "帝王的妻妾宫女"
        },
        {
          "surface": "王子皇孙",
          "pos": "名词",
          "gloss": "六国的王子皇孙"
        },
        {
          "surface": "辞",
          "pos": "动词",
          "gloss": "辞别"
        },
        {
          "surface": "辇",
          "pos": "名词作状语",
          "gloss": "乘辇车"
        },
        {
          "surface": "于",
          "pos": "介词",
          "gloss": "到"
        }
      ]
    },
    {
      "id": "epanggong-013",
      "order": 13,
      "text": "朝歌夜弦，为秦宫人。",
      "translation": "她们日夜唱歌弹琴，成为秦国的宫人。",
      "tokens": [
        {
          "surface": "朝",
          "pos": "名词作状语",
          "gloss": "在早晨"
        },
        {
          "surface": "歌",
          "pos": "动词",
          "gloss": "唱歌"
        },
        {
          "surface": "夜",
          "pos": "名词作状语",
          "gloss": "在夜里"
        },
        {
          "surface": "弦",
          "pos": "动词",
          "gloss": "弹琴"
        },
        {
          "surface": "为",
          "pos": "动词",
          "gloss": "成为"
        }
      ]
    },
    {
      "id": "epanggong-014",
      "order": 14,
      "text": "明星荧荧，开妆镜也；绿云扰扰，梳晓鬟也；渭流涨腻，弃脂水也；烟斜雾横，焚椒兰也。",
      "translation": "明星闪亮，是宫女们打开了梳妆镜；绿云纷乱，是她们在梳早上的发髻；渭水涨起油腻，是她们倒掉了脂水；烟雾斜横，是她们在焚烧椒兰。",
      "tokens": [
        {
          "surface": "荧荧",
          "pos": "形容词",
          "gloss": "闪亮的样子"
        },
        {
          "surface": "妆镜",
          "pos": "名词",
          "gloss": "梳妆镜"
        },
        {
          "surface": "绿云",
          "pos": "名词",
          "gloss": "喻宫女乌黑的头发"
        },
        {
          "surface": "扰扰",
          "pos": "形容词",
          "gloss": "纷乱的样子"
        },
        {
          "surface": "晓鬟",
          "pos": "名词",
          "gloss": "早晨的发髻"
        },
        {
          "surface": "涨腻",
          "pos": "动词",
          "gloss": "涨起油腻"
        },
        {
          "surface": "脂水",
          "pos": "名词",
          "gloss": "含脂粉的洗脸水"
        },
        {
          "surface": "椒兰",
          "pos": "名词",
          "gloss": "椒树和兰草，两种香料"
        }
      ]
    },
    {
      "id": "epanggong-015",
      "order": 15,
      "text": "雷霆乍惊，宫车过也；辘辘远听，杳不知其所之也。",
      "translation": "雷霆突然震响，是宫车经过；辘辘的车声越听越远，遥远得不知它去了哪里。",
      "tokens": [
        {
          "surface": "乍",
          "pos": "副词",
          "gloss": "突然"
        },
        {
          "surface": "惊",
          "pos": "动词",
          "gloss": "震响"
        },
        {
          "surface": "过",
          "pos": "动词",
          "gloss": "经过"
        },
        {
          "surface": "辘辘",
          "pos": "拟声词",
          "gloss": "车声"
        },
        {
          "surface": "杳",
          "pos": "形容词",
          "gloss": "深远"
        },
        {
          "surface": "所之",
          "pos": "固定结构",
          "gloss": "所去的地方"
        }
      ]
    },
    {
      "id": "epanggong-016",
      "order": 16,
      "text": "一肌一容，尽态极妍，缦立远视，而望幸焉。",
      "translation": "每一处肌肤、每一种容貌，都极尽娇媚美丽，长久地站着远望，盼望皇帝到来。",
      "tokens": [
        {
          "surface": "尽态极妍",
          "pos": "固定结构",
          "gloss": "姿态极尽娇媚美丽"
        },
        {
          "surface": "缦立",
          "pos": "动词",
          "gloss": "久立"
        },
        {
          "surface": "远视",
          "pos": "动词",
          "gloss": "远望"
        },
        {
          "surface": "望幸",
          "pos": "动词",
          "gloss": "盼望皇帝到来"
        },
        {
          "surface": "焉",
          "pos": "助词",
          "gloss": "句末语气词"
        }
      ]
    },
    {
      "id": "epanggong-017",
      "order": 17,
      "text": "有不见者，三十六年。",
      "translation": "有的宫女三十六年都没能见到皇帝。",
      "tokens": [
        {
          "surface": "不见",
          "pos": "动词",
          "gloss": "没见过皇帝"
        },
        {
          "surface": "者",
          "pos": "助词",
          "gloss": "……的人"
        },
        {
          "surface": "三十六年",
          "pos": "数量词",
          "gloss": "指秦始皇在位年数"
        }
      ]
    },
    {
      "id": "epanggong-018",
      "order": 18,
      "text": "燕赵之收藏，韩魏之经营，齐楚之精英，几世几年，剽掠其人，倚叠如山。",
      "translation": "燕国赵国收藏的珍宝，韩国魏国聚敛的财物，齐国楚国保存的精华，都是多少代多少年从百姓那里掠夺来的，堆积如山。",
      "tokens": [
        {
          "surface": "之",
          "pos": "助词",
          "gloss": "的"
        },
        {
          "surface": "收藏",
          "pos": "名词",
          "gloss": "收藏的珍宝"
        },
        {
          "surface": "经营",
          "pos": "名词",
          "gloss": "聚敛的财物"
        },
        {
          "surface": "精英",
          "pos": "名词",
          "gloss": "精华"
        },
        {
          "surface": "剽掠",
          "pos": "动词",
          "gloss": "抢劫掠夺"
        },
        {
          "surface": "倚叠",
          "pos": "动词",
          "gloss": "堆积"
        }
      ]
    },
    {
      "id": "epanggong-019",
      "order": 19,
      "text": "一旦不能有，输来其间。",
      "translation": "一旦国家灭亡不能占有，这些珍宝都被运到阿房宫里。",
      "tokens": [
        {
          "surface": "一旦",
          "pos": "连词",
          "gloss": "有一天"
        },
        {
          "surface": "有",
          "pos": "动词",
          "gloss": "占有"
        },
        {
          "surface": "输",
          "pos": "动词",
          "gloss": "运送"
        },
        {
          "surface": "其间",
          "pos": "名词",
          "gloss": "其中，指阿房宫"
        }
      ]
    },
    {
      "id": "epanggong-020",
      "order": 20,
      "text": "鼎铛玉石，金块珠砾，弃掷逦迤，秦人视之，亦不甚惜。",
      "translation": "把宝鼎当作铁锅，把美玉当作石头，把黄金当作土块，把珍珠当作沙砾，丢弃得到处都是，秦人看着，也不很爱惜。",
      "tokens": [
        {
          "surface": "鼎铛玉石",
          "pos": "固定结构",
          "gloss": "把鼎当锅，把玉当石"
        },
        {
          "surface": "金块珠砾",
          "pos": "固定结构",
          "gloss": "把金当土块，把珠当沙砾"
        },
        {
          "surface": "逦迤",
          "pos": "形容词",
          "gloss": "连续不断的样子"
        },
        {
          "surface": "视",
          "pos": "动词",
          "gloss": "看待"
        },
        {
          "surface": "惜",
          "pos": "动词",
          "gloss": "爱惜"
        }
      ]
    },
    {
      "id": "epanggong-021",
      "order": 21,
      "text": "嗟乎！一人之心，千万人之心也。",
      "translation": "唉！一个人的心愿，也就是千万人的心愿啊。",
      "tokens": [
        {
          "surface": "嗟乎",
          "pos": "叹词",
          "gloss": "唉"
        },
        {
          "surface": "之",
          "pos": "助词",
          "gloss": "的"
        },
        {
          "surface": "也",
          "pos": "助词",
          "gloss": "判断句语气词"
        }
      ]
    },
    {
      "id": "epanggong-022",
      "order": 22,
      "text": "秦爱纷奢，人亦念其家。",
      "translation": "秦朝统治者喜爱繁华奢侈，百姓也顾念自己的家。",
      "tokens": [
        {
          "surface": "纷奢",
          "pos": "形容词",
          "gloss": "繁华奢侈"
        },
        {
          "surface": "念",
          "pos": "动词",
          "gloss": "顾念"
        },
        {
          "surface": "其",
          "pos": "代词",
          "gloss": "自己的"
        }
      ]
    },
    {
      "id": "epanggong-023",
      "order": 23,
      "text": "奈何取之尽锱铢，用之如泥沙？",
      "translation": "为什么搜刮时连一锱一铢都不放过，挥霍起来却像泥沙一样？",
      "tokens": [
        {
          "surface": "奈何",
          "pos": "固定结构",
          "gloss": "为什么"
        },
        {
          "surface": "锱铢",
          "pos": "名词",
          "gloss": "极少的钱财"
        },
        {
          "surface": "泥沙",
          "pos": "名词",
          "gloss": "比喻不值钱的东西"
        }
      ]
    },
    {
      "id": "epanggong-024",
      "order": 24,
      "text": "使负栋之柱，多于南亩之农夫；架梁之椽，多于机上之工女；钉头磷磷，多于在庾之粟粒；瓦缝参差，多于周身之帛缕；直栏横槛，多于九土之城郭；管弦呕哑，多于市人之言语。",
      "translation": "使承担栋梁的柱子，比田里的农夫还多；架在梁上的椽子，比织机上的女工还多；钉头密密麻麻，比粮仓里的粟粒还多；瓦缝参差不齐，比全身衣服的丝缕还多；栏杆纵横，比全国的城墙还多；管弦乐声嘈杂，比集市上人们的话语还多。",
      "tokens": [
