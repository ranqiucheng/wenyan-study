        },
        {
          "surface": "骄固",
          "pos": "形容词",
          "gloss": "骄横顽固"
        }
      ]
    },
    {
      "id": "epanggong-027",
      "order": 27,
      "text": "戍卒叫，函谷举，楚人一炬，可怜焦土！",
      "translation": "戍边的士兵一声呼喊，函谷关被攻占，楚人一把大火，可惜阿房宫化为焦土！",
      "tokens": [
