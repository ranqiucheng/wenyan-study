          "pos": "拟声词",
          "gloss": "击物的声音"
        },
        {
          "surface": "魏庄子",
          "pos": "名词",
          "gloss": "晋国大夫魏绛"
        },
        {
          "surface": "歌钟",
          "pos": "名词",
          "gloss": "古代伴奏歌唱的钟"
        },
        {
          "surface": "不余欺",
          "pos": "固定结构",
          "gloss": "宾语前置，即“不欺余”，没有欺骗我们"
        }
      ]
    },
    {
      "id": "shizhongshan-026",
      "order": 26,
      "text": "事不目见耳闻，而臆断其有无，可乎？",
      "translation": "事情没有亲眼看见、亲耳听到，却凭主观猜测推断它的有无，可以吗？",
      "tokens": [
        {
          "surface": "目",
          "pos": "名词",
          "gloss": "名词作状语，用眼睛"
        },
        {
          "surface": "耳",
          "pos": "名词",
          "gloss": "名词作状语，用耳朵"
        },
        {
          "surface": "臆断",
          "pos": "动词",
          "gloss": "凭主观猜测判断"
        },
        {
