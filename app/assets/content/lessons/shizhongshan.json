    },
    {
      "id": "shizhongshan-028",
      "order": 28,
      "text": "士大夫终不肯以小舟夜泊绝壁之下，故莫能知；",
      "translation": "士大夫们终究不肯乘小船在夜里停泊在绝壁之下，所以没有人能够知道；",
      "tokens": [
        {
          "surface": "终",
          "pos": "副词",
          "gloss": "终究"
        },
        {
          "surface": "以",
          "pos": "介词",
          "gloss": "用，乘"
        },
        {
          "surface": "夜泊",
          "pos": "动词",
          "gloss": "夜里停泊"
        },
        {
          "surface": "故",
          "pos": "连词",
          "gloss": "所以"
        },
        {
          "surface": "莫",
          "pos": "代词",
          "gloss": "没有人"
        }
      ]
    },
    {
      "id": "shizhongshan-029",
      "order": 29,
      "text": "而渔工水师虽知而不能言。",
      "translation": "而渔夫船工虽然知道却不能说明白。",
      "tokens": [
        {
          "surface": "渔工水师",
          "pos": "名词",
          "gloss": "渔夫和船工"
