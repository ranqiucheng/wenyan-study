          "gloss": "从上面，作状语"
        },
        {
          "surface": "漏",
          "pos": "动词",
          "gloss": "漏水"
        }
      ]
    },
    {
      "id": "xiangjixuan-007",
      "order": 7,
      "text": "前辟四窗，垣墙周庭，以当南日，日影反照，室始洞然。",
      "translation": "在前面开了四扇窗，砌墙围住院子，用来挡住南面射来的阳光，阳光反射回来，屋子才明亮起来。",
      "tokens": [
        {
          "surface": "前",
          "pos": "名词",
          "gloss": "在前面，作状语"
        },
        {
          "surface": "辟",
          "pos": "动词",
          "gloss": "开辟"
        },
        {
          "surface": "垣墙",
          "pos": "名词",
          "gloss": "砌墙，作动词"
        },
        {
          "surface": "周",
          "pos": "动词",
          "gloss": "围绕"
        },
        {
