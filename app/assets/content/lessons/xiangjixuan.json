          "gloss": "到过一次"
        }
      ]
    },
    {
      "id": "xiangjixuan-020",
      "order": 20,
      "text": "妪每谓余曰：“某所，而母立于兹。”",
      "translation": "老妇人常对我说：“这个地方，你母亲曾站在这儿。”",
      "tokens": [
        {
          "surface": "每",
          "pos": "副词",
          "gloss": "常常"
        },
        {
          "surface": "谓",
          "pos": "动词",
          "gloss": "对……说"
        },
        {
          "surface": "某所",
          "pos": "名词",
          "gloss": "某个地方"
        },
        {
          "surface": "而",
          "pos": "代词",
          "gloss": "你的"
        },
        {
          "surface": "兹",
          "pos": "代词",
          "gloss": "这里"
        }
      ]
    },
    {
      "id": "xiangjixuan-021",
      "order": 21,
      "text": "妪又曰：“汝姊在吾怀，呱呱而泣；",
      "translation": "老妇人又说：“你姐姐在我怀里，呱呱地哭着；",
      "tokens": [
        {
          "surface": "汝姊",
          "pos": "名词",
          "gloss": "你的姐姐"
        },
        {
          "surface": "吾怀",
          "pos": "名词",
          "gloss": "我的怀里"
        },
        {
          "surface": "呱呱",
          "pos": "拟声词",
          "gloss": "哭声"
        },
        {
          "surface": "泣",
          "pos": "动词",
          "gloss": "哭"
        }
      ]
    },
    {
      "id": "xiangjixuan-022",
      "order": 22,
      "text": "娘以指叩门扉曰：‘儿寒乎？欲食乎？’",
      "translation": "你母亲用手指敲着门扇说：‘孩子冷吗？想吃东西吗？’",
      "tokens": [
        {
          "surface": "以",
          "pos": "介词",
          "gloss": "用"
        },
        {
          "surface": "叩",
          "pos": "动词",
          "gloss": "敲"
        },
        {
          "surface": "门扉",
          "pos": "名词",
          "gloss": "门扇"
        },
        {
          "surface": "寒",
          "pos": "形容词",
          "gloss": "冷"
        },
        {
          "surface": "食",
          "pos": "动词",
