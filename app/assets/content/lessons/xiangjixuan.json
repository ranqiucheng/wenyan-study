  "reviewed": true,
  "summary": "归有光借项脊轩的兴废，叙写家族变迁与三代亲情，追忆祖母、母亲与亡妻，于家常琐事中见深挚情感，是明代抒情散文的名篇。",
  "sentences": [
    {
      "id": "xiangjixuan-001",
      "order": 1,
      "text": "项脊轩，旧南阁子也。",
      "translation": "项脊轩，就是原来的南阁子。",
      "tokens": [
        {
          "surface": "旧",
          "pos": "形容词",
          "gloss": "原来的"
        },
        {
          "surface": "南阁子",
          "pos": "名词",
          "gloss": "南面的小阁楼"
        },
        {
          "surface": "也",
          "pos": "助词",
          "gloss": "表判断语气"
        }
      ]
    },
    {
      "id": "xiangjixuan-002",
      "order": 2,
      "text": "室仅方丈，可容一人居。",
      "translation": "屋子只有一丈见方，只能容一个人居住。",
      "tokens": [
        {
          "surface": "仅",
          "pos": "副词",
          "gloss": "只"
        },
        {
          "surface": "方丈",
          "pos": "名词",
          "gloss": "一丈见方"
        },
        {
          "surface": "容",
          "pos": "动词",
          "gloss": "容纳"
        }
      ]
    },
    {
      "id": "xiangjixuan-003",
      "order": 3,
      "text": "百年老屋，尘泥渗漉，雨泽下注；",
      "translation": "这是一百年的老房子，灰尘泥土从屋顶渗漏下来，雨水往下流；",
      "tokens": [
        {
          "surface": "渗漉",
          "pos": "动词",
          "gloss": "渗漏"
        },
        {
          "surface": "雨泽",
          "pos": "名词",
          "gloss": "雨水"
        },
        {
          "surface": "下",
          "pos": "名词",
          "gloss": "向下，作状语"
        },
        {
          "surface": "注",
          "pos": "动词",
          "gloss": "流下"
        }
      ]
    },
    {
      "id": "xiangjixuan-004",
      "order": 4,
      "text": "每移案，顾视无可置者。",
      "translation": "每次移动书桌，环顾四周都没有可以放置的地方。",
      "tokens": [
        {
          "surface": "每",
          "pos": "副词",
          "gloss": "每次"
        },
        {
          "surface": "移案",
          "pos": "动词",
          "gloss": "搬动书桌"
        },
        {
          "surface": "顾视",
          "pos": "动词",
          "gloss": "环顾"
        },
        {
          "surface": "置",
          "pos": "动词",
          "gloss": "放置"
        }
      ]
    },
    {
      "id": "xiangjixuan-005",
      "order": 5,
      "text": "又北向，不能得日，日过午已昏。",
      "translation": "屋子又朝北，得不到阳光，太阳一过中午屋里就昏暗了。",
      "tokens": [
        {
          "surface": "北向",
          "pos": "动词",
          "gloss": "朝北"
        },
        {
          "surface": "得日",
          "pos": "动词",
          "gloss": "得到阳光"
        },
        {
          "surface": "过午",
          "pos": "动词",
          "gloss": "过了正午"
        },
        {
          "surface": "昏",
          "pos": "形容词",
          "gloss": "昏暗"
        }
      ]
    },
    {
      "id": "xiangjixuan-006",
      "order": 6,
      "text": "余稍为修葺，使不上漏。",
      "translation": "我稍微加以修补，使它上面不再漏水。",
      "tokens": [
        {
          "surface": "余",
          "pos": "代词",
          "gloss": "我"
        },
        {
          "surface": "稍",
          "pos": "副词",
