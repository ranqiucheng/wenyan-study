          "gloss": "回答"
        }
      ]
    },
    {
      "id": "xiangjixuan-024",
      "order": 24,
      "text": "语未毕，余泣，妪亦泣。",
      "translation": "话还没说完，我就哭了，老妇人也哭了。",
      "tokens": [
        {
          "surface": "语",
          "pos": "名词",
          "gloss": "话"
        },
        {
          "surface": "毕",
          "pos": "动词",
