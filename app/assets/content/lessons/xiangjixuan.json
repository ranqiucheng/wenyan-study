        },
        {
          "surface": "宴",
          "pos": "动词",
          "gloss": "赴宴"
        },
        {
          "surface": "栖",
          "pos": "动词",
          "gloss": "栖息"
        }
      ]
    },
    {
      "id": "xiangjixuan-016",
      "order": 16,
      "text": "庭中始为篱，已为墙，凡再变矣。",
      "translation": "院中起初是篱笆，后来又筑成墙，总共变动了两次。",
      "tokens": [
