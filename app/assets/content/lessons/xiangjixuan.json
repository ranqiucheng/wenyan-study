      "order": 23,
      "text": "吾从板外相为应答。”",
      "translation": "我从门板外面对她一一应答。”",
      "tokens": [
        {
          "surface": "板外",
          "pos": "名词",
          "gloss": "门板外面"
        },
        {
          "surface": "相为",
