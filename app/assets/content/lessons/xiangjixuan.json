    {
      "id": "xiangjixuan-025",
      "order": 25,
      "text": "余自束发读书轩中，",
      "translation": "我从十五岁起就在轩中读书，",
      "tokens": [
        {
          "surface": "束发",
          "pos": "名词",
          "gloss": "成童的代称，指十五岁"
        },
        {
