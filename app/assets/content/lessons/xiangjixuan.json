    {
      "id": "xiangjixuan-017",
      "order": 17,
      "text": "家有老妪，尝居于此。",
      "translation": "家里有个老妇人，曾经住在这里。",
      "tokens": [
        {
          "surface": "老妪",
          "pos": "名词",
          "gloss": "老妇人"
        },
        {
          "surface": "尝",
