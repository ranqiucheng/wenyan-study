          "pos": "动词",
          "gloss": "挡住"
        },
        {
          "surface": "反照",
          "pos": "动词",
          "gloss": "反射"
        },
        {
          "surface": "洞然",
          "pos": "形容词",
          "gloss": "明亮的样子"
        }
      ]
    },
    {
      "id": "xiangjixuan-008",
      "order": 8,
      "text": "又杂植兰桂竹木于庭，旧时栏楯，亦遂增胜。",
      "translation": "又在院中杂种兰花、桂树、竹子等花木，旧日的栏杆，也因此增添了美景。",
      "tokens": [
        {
          "surface": "杂",
          "pos": "副词",
          "gloss": "混杂"
        },
        {
          "surface": "植",
          "pos": "动词",
          "gloss": "种植"
        },
        {
          "surface": "栏楯",
          "pos": "名词",
          "gloss": "栏杆"
        },
        {
          "surface": "遂",
          "pos": "副词",
          "gloss": "就"
        },
        {
          "surface": "增胜",
          "pos": "动词",
          "gloss": "增添美景"
        }
      ]
    },
    {
      "id": "xiangjixuan-009",
      "order": 9,
      "text": "借书满架，偃仰啸歌，冥然兀坐，万籁有声；",
      "translation": "借来的书摆满书架，我俯仰自如地长啸高歌，有时静静地端坐着，听到自然界各种声音；",
      "tokens": [
        {
          "surface": "偃仰",
          "pos": "动词",
          "gloss": "俯仰，指生活悠然"
        },
        {
          "surface": "啸歌",
          "pos": "动词",
          "gloss": "长啸高歌"
        },
        {
          "surface": "冥然",
          "pos": "形容词",
          "gloss": "静静地"
        },
        {
          "surface": "兀坐",
          "pos": "动词",
          "gloss": "端坐"
        },
        {
          "surface": "万籁",
          "pos": "名词",
          "gloss": "自然界的各种声音"
        }
      ]
    },
    {
      "id": "xiangjixuan-010",
      "order": 10,
      "text": "而庭阶寂寂，小鸟时来啄食，人至不去。",
      "translation": "而庭院台阶一片寂静，小鸟时常来啄食，人走到跟前也不飞走。",
      "tokens": [
        {
          "surface": "寂寂",
          "pos": "形容词",
          "gloss": "寂静"
        },
        {
          "surface": "时",
          "pos": "副词",
          "gloss": "时常"
        },
        {
          "surface": "啄食",
          "pos": "动词",
          "gloss": "啄食"
        },
        {
          "surface": "去",
          "pos": "动词",
          "gloss": "离开"
        }
      ]
    },
    {
      "id": "xiangjixuan-011",
      "order": 11,
      "text": "三五之夜，明月半墙，桂影斑驳，风移影动，珊珊可爱。",
      "translation": "农历十五的夜晚，明月照在半截墙上，桂树的影子错落斑驳，风吹影动，姿态美好可爱。",
      "tokens": [
        {
          "surface": "三五",
          "pos": "名词",
          "gloss": "农历十五"
        },
        {
          "surface": "半墙",
          "pos": "名词",
          "gloss": "半截墙"
        },
        {
          "surface": "斑驳",
          "pos": "形容词",
          "gloss": "错杂的样子"
        },
        {
          "surface": "珊珊",
          "pos": "形容词",
          "gloss": "美好的样子"
        }
      ]
    },
    {
      "id": "xiangjixuan-012",
      "order": 12,
      "text": "然余居于此，多可喜，亦多可悲。",
      "translation": "但是我住在这里，有许多值得高兴的事，也有许多值得悲伤的事。",
      "tokens": [
        {
          "surface": "然",
          "pos": "连词",
          "gloss": "但是"
        },
        {
          "surface": "居",
          "pos": "动词",
          "gloss": "居住"
        },
        {
          "surface": "于",
          "pos": "介词",
          "gloss": "在"
        },
        {
          "surface": "可喜",
          "pos": "形容词",
          "gloss": "值得高兴"
        },
        {
          "surface": "可悲",
          "pos": "形容词",
          "gloss": "值得悲伤"
        }
      ]
    },
    {
      "id": "xiangjixuan-013",
      "order": 13,
      "text": "先是庭中通南北为一。",
      "translation": "在这以前，院子南北相通是一个整体。",
      "tokens": [
        {
          "surface": "先是",
          "pos": "副词",
          "gloss": "在这以前"
        },
        {
          "surface": "通",
          "pos": "动词",
          "gloss": "相通"
        },
        {
          "surface": "为",
          "pos": "动词",
          "gloss": "成为"
        },
        {
          "surface": "一",
          "pos": "数词",
          "gloss": "一体"
        }
      ]
    },
    {
      "id": "xiangjixuan-014",
      "order": 14,
      "text": "迨诸父异爨，内外多置小门墙，往往而是。",
      "translation": "等到伯父叔父们分家过日子，里里外外设置了许多小门和墙，到处都是。",
      "tokens": [
        {
          "surface": "迨",
          "pos": "介词",
          "gloss": "等到"
        },
        {
          "surface": "诸父",
          "pos": "名词",
          "gloss": "伯父叔父们"
        },
        {
          "surface": "异爨",
          "pos": "动词",
          "gloss": "分灶做饭，指分家"
        },
