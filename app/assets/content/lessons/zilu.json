    },
    {
      "id": "zilu-003",
      "order": 3,
      "text": "居则曰：‘不吾知也！’",
      "translation": "你们平日闲居时常说：‘没有人了解我呀。’",
      "tokens": [
        {
          "surface": "居",
          "pos": "动词",
          "gloss": "平日闲居"
