          "surface": "尊",
          "pos": "形容词",
          "gloss": "尊贵"
        },
        {
          "surface": "于",
          "pos": "介词",
          "gloss": "比"
        }
      ]
    },
    {
      "id": "guoqin-040",
      "order": 40,
      "text": "锄櫌棘矜，非铦于钩戟长铩也；",
      "translation": "锄头木棍，并不比钩戟长矛锋利；",
      "tokens": [
        {
          "surface": "锄櫌棘矜",
          "pos": "名词",
          "gloss": "锄头木棍等农具"
