          "pos": "动词",
          "gloss": "控制"
        },
        {
          "surface": "朝",
          "pos": "动词使动",
          "gloss": "使……来朝见"
        }
      ]
    },
    {
      "id": "guoqin-046",
      "order": 46,
      "text": "然后以六合为家，崤函为宫；",
      "translation": "然后把天下作为家，把崤山函谷关作为宫殿；",
      "tokens": [
        {
          "surface": "六合",
          "pos": "名词",
          "gloss": "天地四方，指天下"
        },
        {
          "surface": "为",
          "pos": "动词",
          "gloss": "作为"
        },
        {
          "surface": "宫",
          "pos": "名词",
          "gloss": "宫殿"
        }
      ]
    },
    {
      "id": "guoqin-047",
      "order": 47,
      "text": "一夫作难而七庙隳，身死人手，为天下笑者，何也？",
      "translation": "一个普通人起义而宗庙毁灭，自己死在别人手里，被天下人耻笑，为什么呢？",
      "tokens": [
        {
          "surface": "一夫",
          "pos": "名词",
          "gloss": "一个人"
        },
        {
