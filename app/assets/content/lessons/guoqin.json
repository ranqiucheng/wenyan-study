        {
          "surface": "小弱",
          "pos": "形容词",
          "gloss": "变小变弱"
        },
        {
          "surface": "自若",
          "pos": "形容词",
          "gloss": "像原来一样"
        }
      ]
    },
    {
      "id": "guoqin-039",
      "order": 39,
      "text": "陈涉之位，非尊于齐、楚、燕、赵、韩、魏、宋、卫、中山之君也；",
      "translation": "陈涉的地位，并不比齐、楚、燕、赵、韩、魏、宋、卫、中山的君主尊贵；",
      "tokens": [
