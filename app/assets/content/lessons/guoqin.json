          "gloss": "耻笑"
        }
      ]
    },
    {
      "id": "guoqin-048",
      "order": 48,
      "text": "仁义不施而攻守之势异也。",
      "translation": "是因为不施行仁义，攻取和守卫的形势就不同了啊。",
      "tokens": [
        {
          "surface": "施",
          "pos": "动词",
          "gloss": "施行"
        },
        {
          "surface": "攻守之势",
