          "gloss": "比得上"
        },
        {
          "surface": "向时",
          "pos": "名词",
          "gloss": "从前"
        }
      ]
    },
    {
      "id": "guoqin-043",
      "order": 43,
      "text": "然而成败异变，功业相反，何也？",
      "translation": "然而成功与失败却大不相同，功业完全相反，为什么呢？",
      "tokens": [
        {
          "surface": "异变",
          "pos": "动词",
          "gloss": "不同"
        },
        {
          "surface": "相反",
          "pos": "形容词",
          "gloss": "相反"
        },
        {
          "surface": "何也",
          "pos": "固定结构",
          "gloss": "为什么呢"
        }
      ]
    },
    {
      "id": "guoqin-044",
      "order": 44,
      "text": "试使山东之国与陈涉度长絜大，比权量力，则不可同年而语矣。",
      "translation": "试让崤山以东的国家与陈涉比量长短大小、比较权势力量，那就不能相提并论了。",
      "tokens": [
        {
          "surface": "度长絜大",
          "pos": "动词",
          "gloss": "比量长短大小"
        },
        {
          "surface": "比权量力",
          "pos": "动词",
          "gloss": "比较权势力量"
        },
        {
          "surface": "同年而语",
          "pos": "固定结构",
          "gloss": "相提并论"
        }
      ]
    },
    {
      "id": "guoqin-045",
      "order": 45,
      "text": "然秦以区区之地，致万乘之势，序八州而朝同列，百有余年矣；",
      "translation": "然而秦国凭着小小的土地，达到万乘之势，控制八州而使同列的诸侯来朝见，已有一百多年了；",
      "tokens": [
        {
          "surface": "区区",
          "pos": "形容词",
          "gloss": "小小"
        },
        {
          "surface": "致",
          "pos": "动词",
          "gloss": "达到"
        },
        {
          "surface": "万乘",
          "pos": "名词",
          "gloss": "万辆兵车，指天子之国"
        },
        {
