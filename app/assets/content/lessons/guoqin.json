        },
        {
          "surface": "转",
          "pos": "动词",
          "gloss": "转过头"
        }
      ]
    },
    {
      "id": "guoqin-036",
      "order": 36,
      "text": "斩木为兵，揭竿为旗，天下云集响应，赢粮而景从。",
      "translation": "砍下树木作兵器，举起竹竿作旗帜，天下人像云一样聚集、像回声一样应和，担着粮食像影子一样跟随他。",
      "tokens": [
        {
