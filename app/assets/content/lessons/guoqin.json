{
  "id": "guoqin",
  "title": "过秦论（上）",
  "author": "贾谊",
  "source": "《新书》",
  "volume": "选择性必修中册",
  "tags": [
    "课标",
    "议论"
  ],
  "reviewed": true,
  "summary": "铺叙秦由弱小到强盛、又迅速灭亡的史实，归结出“仁义不施而攻守之势异也”的教训。",
  "sentences": [
    {
      "id": "guoqin-001",
      "order": 1,
      "text": "秦孝公据崤函之固，拥雍州之地，君臣固守以窥周室，",
      "translation": "秦孝公占据崤山、函谷关那样险固的地势，拥有雍州的土地，君臣牢固防守，来窥伺周王朝的政权，",
      "tokens": [
        {
          "surface": "据",
          "pos": "动词",
          "gloss": "占据"
        },
        {
          "surface": "崤函",
          "pos": "名词",
          "gloss": "崤山和函谷关"
        },
        {
          "surface": "固",
          "pos": "名词",
          "gloss": "险固的地势"
        },
        {
          "surface": "拥",
          "pos": "动词",
          "gloss": "拥有"
        },
        {
          "surface": "窥",
          "pos": "动词",
          "gloss": "窥伺"
        }
      ]
    },
    {
      "id": "guoqin-002",
      "order": 2,
      "text": "有席卷天下，包举宇内，囊括四海之意，并吞八荒之心。",
      "translation": "有像卷席子一样吞并天下、像包裹一样收揽宇内、像装袋子一样囊括四海的意图，有并吞八方荒远之地的野心。",
      "tokens": [
        {
          "surface": "席卷",
          "pos": "动词",
          "gloss": "像卷席一样吞并"
        },
        {
          "surface": "包举",
          "pos": "动词",
          "gloss": "包裹收揽"
        },
        {
          "surface": "囊括",
          "pos": "动词",
          "gloss": "像口袋一样收括"
        },
        {
          "surface": "八荒",
          "pos": "名词",
          "gloss": "八方荒远之地"
        }
      ]
    },
    {
      "id": "guoqin-003",
      "order": 3,
      "text": "当是时也，商君佐之，内立法度，务耕织，修守战之具，外连衡而斗诸侯。",
      "translation": "在这个时候，商鞅辅佐他，对内建立法令制度，致力于耕织，修造防守作战的器械，对外实行连衡策略使诸侯相斗。",
      "tokens": [
        {
          "surface": "是时",
          "pos": "名词",
          "gloss": "这时"
        },
        {
          "surface": "佐",
          "pos": "动词",
          "gloss": "辅佐"
        },
        {
          "surface": "内",
          "pos": "名词作状语",
          "gloss": "对内"
        },
        {
          "surface": "务",
          "pos": "动词",
          "gloss": "致力于"
        },
        {
          "surface": "修",
          "pos": "动词",
          "gloss": "修造"
        },
        {
          "surface": "连衡",
          "pos": "动词",
          "gloss": "连横"
        },
        {
          "surface": "斗",
          "pos": "动词",
          "gloss": "使动用法，使……相斗"
        }
      ]
    },
    {
      "id": "guoqin-004",
      "order": 4,
      "text": "于是秦人拱手而取西河之外。",
      "translation": "于是秦人毫不费力地夺取了西河之外的土地。",
      "tokens": [
        {
          "surface": "拱手",
          "pos": "动词",
          "gloss": "两手合抱，形容毫不费力"
        },
        {
          "surface": "取",
          "pos": "动词",
          "gloss": "夺取"
        },
        {
          "surface": "西河之外",
          "pos": "名词",
          "gloss": "黄河以西的地区"
        }
      ]
    },
    {
      "id": "guoqin-005",
      "order": 5,
      "text": "孝公既没，惠文、武、昭襄蒙故业，因遗策，",
      "translation": "秦孝公死后，惠文王、武王、昭襄王继承已有的基业，沿袭前代的策略，",
      "tokens": [
        {
          "surface": "既没",
          "pos": "动词",
          "gloss": "死后，“没”通“殁”"
        },
        {
          "surface": "蒙",
          "pos": "动词",
          "gloss": "继承"
        },
        {
          "surface": "故业",
          "pos": "名词",
          "gloss": "已有的基业"
        },
        {
          "surface": "因",
          "pos": "动词",
          "gloss": "沿袭"
        },
        {
          "surface": "遗策",
          "pos": "名词",
          "gloss": "前代留下的策略"
        }
      ]
    },
    {
      "id": "guoqin-006",
      "order": 6,
      "text": "南取汉中，西举巴、蜀，东割膏腴之地，北收要害之郡。",
      "translation": "向南夺取汉中，向西攻取巴、蜀，向东割取肥沃的土地，向北收取险要的郡邑。",
      "tokens": [
        {
          "surface": "南",
          "pos": "名词作状语",
          "gloss": "向南"
        },
        {
          "surface": "举",
          "pos": "动词",
          "gloss": "攻取"
        },
        {
          "surface": "膏腴",
          "pos": "形容词",
          "gloss": "肥沃"
        },
        {
          "surface": "要害",
          "pos": "形容词",
          "gloss": "险要"
        },
        {
          "surface": "郡",
          "pos": "名词",
          "gloss": "郡邑"
        }
      ]
    },
    {
      "id": "guoqin-007",
      "order": 7,
      "text": "诸侯恐惧，会盟而谋弱秦，不爱珍器重宝肥饶之地，以致天下之士，合从缔交，相与为一。",
      "translation": "诸侯恐惧，会盟商议削弱秦国，不吝惜珍贵的器物、贵重的宝物和肥沃富饶的土地，用来招纳天下的贤士，采用合纵的策略缔结盟约，互相援助成为一体。",
      "tokens": [
        {
          "surface": "弱",
          "pos": "形容词使动",
          "gloss": "使……削弱"
        },
        {
          "surface": "爱",
          "pos": "动词",
          "gloss": "吝惜"
        },
        {
          "surface": "致",
          "pos": "动词",
          "gloss": "招纳"
        },
        {
          "surface": "合从",
          "pos": "动词",
          "gloss": "合纵"
        },
        {
          "surface": "缔交",
          "pos": "动词",
          "gloss": "缔结盟约"
        },
        {
          "surface": "相与",
          "pos": "副词",
          "gloss": "互相"
        },
        {
          "surface": "一",
          "pos": "动词",
          "gloss": "成为一体"
        }
      ]
    },
    {
      "id": "guoqin-008",
      "order": 8,
      "text": "当此之时，齐有孟尝，赵有平原，楚有春申，魏有信陵。",
      "translation": "在这个时候，齐国有孟尝君，赵国有平原君，楚国有春申君，魏国有信陵君。",
      "tokens": [
        {
          "surface": "当",
          "pos": "介词",
          "gloss": "在"
        },
        {
          "surface": "孟尝",
          "pos": "名词",
          "gloss": "孟尝君"
        },
        {
          "surface": "平原",
          "pos": "名词",
          "gloss": "平原君"
        },
        {
          "surface": "春申",
          "pos": "名词",
          "gloss": "春申君"
        },
        {
          "surface": "信陵",
          "pos": "名词",
          "gloss": "信陵君"
        }
      ]
    },
    {
      "id": "guoqin-009",
      "order": 9,
      "text": "此四君者，皆明智而忠信，宽厚而爱人，尊贤而重士，",
      "translation": "这四位君子，都明智而忠诚信义，宽厚而爱护他人，尊敬贤才而重视士人，",
      "tokens": [
        {
          "surface": "明智",
          "pos": "形容词",
          "gloss": "明智"
        },
        {
          "surface": "忠信",
          "pos": "形容词",
          "gloss": "忠诚信义"
        },
        {
          "surface": "爱人",
          "pos": "动词",
          "gloss": "爱护他人"
        },
        {
          "surface": "尊贤",
          "pos": "动词",
          "gloss": "尊敬贤才"
        },
        {
          "surface": "重士",
          "pos": "动词",
          "gloss": "重视士人"
        }
      ]
    },
    {
      "id": "guoqin-010",
      "order": 10,
      "text": "约从离衡，兼韩、魏、燕、楚、齐、赵、宋、卫、中山之众。",
      "translation": "相约合纵，离散秦国的连衡，聚集韩、魏、燕、楚、齐、赵、宋、卫、中山的军队。",
      "tokens": [
        {
          "surface": "约从",
          "pos": "动词",
          "gloss": "相约合纵"
        },
        {
          "surface": "离衡",
          "pos": "动词",
          "gloss": "离散连横"
        },
        {
          "surface": "兼",
          "pos": "动词",
          "gloss": "聚集"
        },
        {
          "surface": "众",
          "pos": "名词",
          "gloss": "军队"
        }
      ]
    },
    {
      "id": "guoqin-011",
      "order": 11,
      "text": "于是六国之士，有宁越、徐尚、苏秦、杜赫之属为之谋，",
      "translation": "于是六国的士人，有宁越、徐尚、苏秦、杜赫这一类人为他们谋划，",
      "tokens": [
        {
          "surface": "之属",
          "pos": "名词",
          "gloss": "这一类人"
        },
        {
          "surface": "为",
          "pos": "介词",
          "gloss": "替"
        },
        {
          "surface": "谋",
          "pos": "动词",
          "gloss": "谋划"
        }
      ]
    },
    {
      "id": "guoqin-012",
      "order": 12,
      "text": "齐明、周最、陈轸、召滑、楼缓、翟景、苏厉、乐毅之徒通其意，",
      "translation": "齐明、周最、陈轸、召滑、楼缓、翟景、苏厉、乐毅这些人沟通他们的意图，",
      "tokens": [
        {
          "surface": "之徒",
          "pos": "名词",
          "gloss": "这些人"
        },
        {
          "surface": "通",
          "pos": "动词",
          "gloss": "沟通"
        },
        {
          "surface": "意",
          "pos": "名词",
          "gloss": "意图"
        }
      ]
    },
    {
      "id": "guoqin-013",
      "order": 13,
      "text": "吴起、孙膑、带佗、倪良、王廖、田忌、廉颇、赵奢之伦制其兵。",
      "translation": "吴起、孙膑、带佗、倪良、王廖、田忌、廉颇、赵奢这些人统率他们的军队。",
      "tokens": [
        {
          "surface": "之伦",
          "pos": "名词",
          "gloss": "这些人"
        },
        {
          "surface": "制",
          "pos": "动词",
          "gloss": "统率"
        },
        {
          "surface": "兵",
          "pos": "名词",
          "gloss": "军队"
        }
      ]
    },
    {
      "id": "guoqin-014",
      "order": 14,
      "text": "尝以十倍之地，百万之众，叩关而攻秦。",
      "translation": "他们曾经用十倍于秦的土地、百万的军队，攻打函谷关进攻秦国。",
      "tokens": [
        {
          "surface": "尝",
          "pos": "副词",
          "gloss": "曾经"
        },
        {
          "surface": "以",
          "pos": "介词",
          "gloss": "用"
        },
        {
          "surface": "叩关",
          "pos": "动词",
          "gloss": "攻打函谷关"
        },
        {
          "surface": "攻",
          "pos": "动词",
          "gloss": "进攻"
        }
      ]
    },
    {
      "id": "guoqin-015",
      "order": 15,
      "text": "秦人开关延敌，九国之师，逡巡而不敢进。",
      "translation": "秦人打开函谷关迎击敌人，九国的军队却迟疑徘徊而不敢前进。",
      "tokens": [
        {
          "surface": "延敌",
          "pos": "动词",
          "gloss": "迎击敌人"
        },
        {
          "surface": "九国",
          "pos": "名词",
          "gloss": "九个国家"
        },
        {
          "surface": "逡巡",
          "pos": "动词",
          "gloss": "迟疑徘徊"
        },
        {
          "surface": "进",
          "pos": "动词",
          "gloss": "前进"
        }
      ]
    },
    {
      "id": "guoqin-016",
      "order": 16,
      "text": "秦无亡矢遗镞之费，而天下诸侯已困矣。",
      "translation": "秦国没有耗费一支箭、一个箭头，可是天下诸侯已经困乏了。",
      "tokens": [
        {
          "surface": "亡",
          "pos": "动词",
          "gloss": "丢失"
        },
        {
          "surface": "遗",
          "pos": "动词",
          "gloss": "遗失"
        },
        {
          "surface": "镞",
          "pos": "名词",
          "gloss": "箭头"
        },
        {
          "surface": "费",
          "pos": "名词",
          "gloss": "耗费"
        },
        {
          "surface": "困",
          "pos": "形容词",
          "gloss": "困乏"
        }
      ]
    },
    {
      "id": "guoqin-017",
      "order": 17,
      "text": "于是从散约败，争割地而赂秦。",
      "translation": "于是合纵离散、盟约破坏，诸侯争着割地来贿赂秦国。",
      "tokens": [
        {
          "surface": "从散",
          "pos": "动词",
          "gloss": "合纵离散"
        },
        {
          "surface": "约败",
          "pos": "动词",
          "gloss": "盟约破坏"
        },
        {
          "surface": "赂",
          "pos": "动词",
          "gloss": "贿赂"
        }
      ]
    },
    {
      "id": "guoqin-018",
      "order": 18,
      "text": "秦有余力而制其弊，追亡逐北，伏尸百万，流血漂橹；",
      "translation": "秦国有余力乘他们困弊而制服他们，追赶逃亡败走的军队，倒下的尸体百万，流的血能漂浮起大盾；",
      "tokens": [
        {
          "surface": "制",
          "pos": "动词",
          "gloss": "制服"
        },
        {
          "surface": "弊",
          "pos": "名词",
          "gloss": "困弊"
        },
        {
          "surface": "亡",
          "pos": "名词",
          "gloss": "逃亡的军队"
        },
        {
          "surface": "北",
          "pos": "名词",
          "gloss": "败走的军队"
        },
        {
          "surface": "漂橹",
          "pos": "动词",
          "gloss": "使大盾漂浮"
        }
      ]
    },
    {
      "id": "guoqin-019",
      "order": 19,
      "text": "因利乘便，宰割天下，分裂山河。",
      "translation": "趁着有利的形势和便利的条件，宰割天下，分裂山河。",
      "tokens": [
        {
          "surface": "因",
          "pos": "介词",
          "gloss": "趁着"
        },
        {
          "surface": "乘",
          "pos": "动词",
          "gloss": "趁着"
        },
        {
          "surface": "宰割",
          "pos": "动词",
          "gloss": "分割"
        },
        {
          "surface": "分裂",
          "pos": "动词",
          "gloss": "分裂"
        }
      ]
    },
    {
      "id": "guoqin-020",
      "order": 20,
      "text": "强国请服，弱国入朝。",
      "translation": "强国请求归服，弱国前来入朝。",
      "tokens": [
        {
          "surface": "请服",
          "pos": "动词",
          "gloss": "请求归服"
        },
        {
          "surface": "入朝",
          "pos": "动词",
          "gloss": "前来朝见"
        }
      ]
    },
    {
      "id": "guoqin-021",
      "order": 21,
      "text": "延及孝文王、庄襄王，享国之日浅，国家无事。",
      "translation": "延续到孝文王、庄襄王，他们在位的时间短，国家没有变故。",
      "tokens": [
        {
          "surface": "延及",
          "pos": "动词",
          "gloss": "延续到"
        },
        {
          "surface": "享国",
          "pos": "动词",
          "gloss": "在位"
        },
        {
          "surface": "浅",
          "pos": "形容词",
          "gloss": "短"
        },
        {
          "surface": "无事",
          "pos": "动词",
          "gloss": "没有变故"
        }
      ]
    },
    {
      "id": "guoqin-022",
      "order": 22,
      "text": "及至始皇，奋六世之余烈，振长策而御宇内，吞二周而亡诸侯，履至尊而制六合，执敲扑而鞭笞天下，威振四海。",
      "translation": "到了秦始皇，他发扬六代遗留下来的功业，挥舞长鞭来驾驭天下，吞并东西二周而灭亡诸侯，登上至尊之位而控制天下，拿着刑具来鞭打天下百姓，威势震动四海。",
      "tokens": [
        {
          "surface": "奋",
          "pos": "动词",
          "gloss": "发扬"
        },
        {
          "surface": "余烈",
          "pos": "名词",
          "gloss": "遗留的功业"
        },
        {
          "surface": "振",
          "pos": "动词",
          "gloss": "挥舞"
        },
        {
          "surface": "御",
          "pos": "动词",
          "gloss": "驾驭"
        },
        {
          "surface": "亡",
          "pos": "动词使动",
          "gloss": "使……灭亡"
        },
        {
          "surface": "履",
          "pos": "动词",
          "gloss": "登上"
        },
        {
          "surface": "敲扑",
          "pos": "名词",
          "gloss": "刑具"
        },
        {
          "surface": "鞭笞",
          "pos": "动词",
          "gloss": "鞭打"
        }
      ]
    },
    {
      "id": "guoqin-023",
      "order": 23,
      "text": "南取百越之地，以为桂林、象郡；",
      "translation": "向南夺取百越的土地，把它设置为桂林郡、象郡；",
      "tokens": [
        {
          "surface": "以为",
          "pos": "固定结构",
          "gloss": "把……作为"
        },
        {
          "surface": "桂林",
          "pos": "名词",
          "gloss": "桂林郡"
        },
        {
          "surface": "象郡",
          "pos": "名词",
          "gloss": "象郡"
        }
      ]
    },
    {
      "id": "guoqin-024",
      "order": 24,
      "text": "百越之君，俯首系颈，委命下吏。",
      "translation": "百越的君主低着头、把绳子系在颈上，把自己的性命交给下级官吏。",
      "tokens": [
        {
          "surface": "俯首",
          "pos": "动词",
          "gloss": "低头"
        },
        {
          "surface": "系颈",
