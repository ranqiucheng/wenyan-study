  "summary": "选录《老子》八章，围绕上善若水、不争、守道、知人自知、为而不争等命题，体现老子以“道”为核心的人生与政治智慧。",
  "sentences": [
    {
      "id": "laozi8-001",
      "order": 1,
      "text": "上善若水，水善利万物而不争。",
      "translation": "最高的善像水一样，水善于滋润万物却不与万物相争。",
      "tokens": [
        {
          "surface": "上善",
          "pos": "名词",
          "gloss": "最高的善，指最善的人"
        },
        {
          "surface": "若",
          "pos": "动词",
          "gloss": "像"
        },
        {
          "surface": "利",
          "pos": "动词",
          "gloss": "使……受益"
        },
        {
          "surface": "万物",
          "pos": "名词",
          "gloss": "万物"
        },
        {
          "surface": "争",
          "pos": "动词",
          "gloss": "争夺，相争"
        }
      ]
    },
    {
      "id": "laozi8-002",
      "order": 2,
      "text": "处众人之所恶，故几于道。",
      "translation": "它处在众人所厌恶的低处，所以最接近于“道”。",
      "tokens": [
        {
          "surface": "处",
          "pos": "动词",
          "gloss": "居处，处在"
        },
        {
          "surface": "所恶",
          "pos": "名词",
          "gloss": "所厌恶的地方"
        },
        {
          "surface": "几",
          "pos": "动词",
          "gloss": "接近"
        },
        {
          "surface": "道",
          "pos": "名词",
          "gloss": "老子哲学中万物的本原与规律"
        }
      ]
    },
    {
      "id": "laozi8-003",
      "order": 3,
      "text": "居善地，心善渊，与善仁，言善信，政善治，事善能，动善时。",
      "translation": "居处善于选择低下的地方，内心善于保持深沉宁静，待人善于真诚友爱，说话善于恪守信用，为政善于治理，处事善于发挥所长，行动善于把握时机。",
      "tokens": [
        {
          "surface": "居",
          "pos": "动词",
          "gloss": "居处"
        },
        {
          "surface": "渊",
          "pos": "形容词",
          "gloss": "深沉宁静"
        },
        {
          "surface": "与",
          "pos": "动词",
          "gloss": "与人交往"
        },
        {
          "surface": "信",
          "pos": "名词",
          "gloss": "诚信"
        },
        {
          "surface": "治",
          "pos": "动词",
          "gloss": "治理得好"
        },
        {
          "surface": "能",
          "pos": "动词",
          "gloss": "发挥所长"
        },
        {
          "surface": "时",
          "pos": "动词",
          "gloss": "把握时机"
        }
      ]
    },
    {
      "id": "laozi8-004",
      "order": 4,
      "text": "夫唯不争，故无尤。",
      "translation": "正因为不与人争，所以没有过失和怨咎。",
      "tokens": [
        {
          "surface": "夫唯",
          "pos": "连词",
          "gloss": "正因为"
        },
        {
          "surface": "争",
          "pos": "动词",
          "gloss": "争夺"
        },
        {
          "surface": "尤",
          "pos": "名词",
          "gloss": "过失，怨咎"
        }
      ]
    },
    {
      "id": "laozi8-005",
      "order": 5,
      "text": "五色令人目盲，五音令人耳聋，五味令人口爽，驰骋畋猎令人心发狂，难得之货令人行妨。",
      "translation": "缤纷的色彩使人眼花缭乱，纷杂的声音使人听觉失灵，丰美的味道使人口味败坏，纵马打猎使人心浮意狂，稀有的财物使人行为不轨。",
      "tokens": [
        {
          "surface": "五色",
          "pos": "名词",
          "gloss": "缤纷的色彩"
        },
        {
          "surface": "目盲",
          "pos": "形容词",
          "gloss": "眼花缭乱"
        },
        {
          "surface": "五音",
          "pos": "名词",
          "gloss": "纷杂的声音"
        },
        {
          "surface": "口爽",
          "pos": "形容词",
          "gloss": "味觉失灵"
        },
        {
          "surface": "畋猎",
          "pos": "动词",
          "gloss": "打猎"
        },
        {
          "surface": "心发狂",
          "pos": "动词",
          "gloss": "心浮意狂"
        },
        {
          "surface": "行妨",
          "pos": "动词",
          "gloss": "伤害操行"
        }
      ]
    },
    {
      "id": "laozi8-006",
      "order": 6,
      "text": "是以圣人为腹不为目，故去彼取此。",
      "translation": "因此圣人只求温饱而不求声色之娱，所以舍弃那些而选取这些。",
      "tokens": [
        {
          "surface": "是以",
          "pos": "连词",
          "gloss": "因此"
        },
        {
          "surface": "为腹",
          "pos": "动词",
          "gloss": "只求温饱"
        },
        {
          "surface": "为目",
          "pos": "动词",
          "gloss": "追求声色之娱"
        },
        {
          "surface": "去",
          "pos": "动词",
          "gloss": "舍弃"
        },
        {
          "surface": "取",
          "pos": "动词",
          "gloss": "选取"
        }
      ]
    },
    {
      "id": "laozi8-007",
      "order": 7,
      "text": "古之善为士者，微妙玄通，深不可识。",
      "translation": "古时善于行道的人，精微深奥而通达，深邃得无法认识。",
      "tokens": [
        {
          "surface": "善为士者",
          "pos": "名词",
          "gloss": "善于行道的人"
        },
        {
          "surface": "微妙玄通",
          "pos": "形容词",
          "gloss": "精微深奥而通达"
        },
        {
          "surface": "深",
          "pos": "副词",
          "gloss": "深深地"
        },
        {
          "surface": "识",
          "pos": "动词",
          "gloss": "认识，测度"
        }
      ]
    },
    {
      "id": "laozi8-008",
      "order": 8,
      "text": "夫唯不可识，故强为之容：豫兮，若冬涉川；犹兮，若畏四邻；俨兮，其若客；涣兮，若冰之将释；敦兮，其若朴；旷兮，其若谷；混兮，其若浊。",
      "translation": "正因为无法认识，所以只能勉强地形容他：小心谨慎啊，像冬天过河；警觉戒备啊，像提防四邻；庄重恭敬啊，像做客；洒脱流散啊，像冰将要消融；敦厚朴实啊，像未经加工的原木；空旷开阔啊，像深谷；浑厚宽博啊，像浑浊的江河。",
      "tokens": [
        {
          "surface": "强",
          "pos": "副词",
          "gloss": "勉强"
        },
        {
          "surface": "容",
          "pos": "动词",
          "gloss": "形容，描述"
        },
        {
          "surface": "豫",
          "pos": "形容词",
          "gloss": "迟疑慎重"
        },
        {
          "surface": "犹",
          "pos": "形容词",
          "gloss": "警觉戒备"
        },
        {
          "surface": "俨",
          "pos": "形容词",
          "gloss": "庄重恭敬"
        },
        {
          "surface": "涣",
          "pos": "形容词",
          "gloss": "洒脱流散"
        },
        {
          "surface": "敦",
          "pos": "形容词",
          "gloss": "敦厚朴实"
        },
        {
          "surface": "混",
          "pos": "形容词",
          "gloss": "浑厚宽博"
        }
      ]
    },
    {
      "id": "laozi8-009",
      "order": 9,
      "text": "孰能浊以止，静之徐清？孰能安以久，动之徐生？",
      "translation": "谁能像浑浊的水那样，安静下来慢慢澄清？谁能像安定的状态那样，变动起来慢慢显出生机？",
      "tokens": [
        {
          "surface": "孰",
          "pos": "代词",
          "gloss": "谁"
        },
        {
          "surface": "浊",
          "pos": "形容词",
          "gloss": "浑浊"
        },
        {
          "surface": "静",
          "pos": "动词",
          "gloss": "使……静止"
        },
        {
          "surface": "徐",
          "pos": "副词",
          "gloss": "慢慢地"
        },
        {
          "surface": "安",
          "pos": "形容词",
          "gloss": "安定"
        },
        {
          "surface": "动",
          "pos": "动词",
          "gloss": "变动，使之动"
        }
      ]
    },
    {
      "id": "laozi8-010",
      "order": 10,
      "text": "保此道者，不欲盈。",
      "translation": "保持这种“道”的人，不追求盈满。",
      "tokens": [
        {
          "surface": "保",
          "pos": "动词",
          "gloss": "保持"
        },
        {
          "surface": "此道",
          "pos": "名词",
          "gloss": "这“道”"
        },
        {
          "surface": "盈",
          "pos": "形容词",
          "gloss": "自满"
        }
      ]
    },
    {
      "id": "laozi8-011",
      "order": 11,
      "text": "夫唯不盈，故能敝而新成。",
      "translation": "正因为不盈满，所以能够去故更新。",
      "tokens": [
        {
          "surface": "夫唯",
          "pos": "连词",
          "gloss": "正因为"
        },
        {
          "surface": "盈",
          "pos": "形容词",
          "gloss": "自满"
        },
        {
          "surface": "敝",
          "pos": "形容词",
          "gloss": "陈旧，破旧"
        },
        {
          "surface": "新成",
          "pos": "动词",
          "gloss": "更新成就"
        }
      ]
    },
    {
      "id": "laozi8-012",
      "order": 12,
      "text": "曲则全，枉则直；洼则盈，敝则新；少则得，多则惑。",
      "translation": "委曲反而能保全，弯曲反而能伸直；低洼反而能充盈，陈旧反而能生新；少取反而能获得，贪多反而迷惑。",
      "tokens": [
        {
          "surface": "曲",
          "pos": "形容词",
          "gloss": "委曲"
        },
        {
          "surface": "全",
          "pos": "动词",
          "gloss": "保全"
        },
        {
          "surface": "枉",
          "pos": "形容词",
          "gloss": "弯曲"
        },
        {
          "surface": "直",
          "pos": "动词",
          "gloss": "伸直"
        },
        {
          "surface": "洼",
          "pos": "形容词",
          "gloss": "低洼"
        },
        {
          "surface": "敝",
          "pos": "形容词",
          "gloss": "陈旧"
        },
        {
          "surface": "惑",
          "pos": "动词",
          "gloss": "迷惑"
        }
      ]
    },
    {
      "id": "laozi8-013",
      "order": 13,
      "text": "是以圣人抱一为天下式。",
      "translation": "因此圣人坚守“道”，作为天下的范式。",
      "tokens": [
        {
          "surface": "是以",
          "pos": "连词",
          "gloss": "因此"
        },
        {
          "surface": "抱一",
          "pos": "动词",
          "gloss": "坚守“道”"
        },
        {
          "surface": "式",
          "pos": "名词",
          "gloss": "法式，范式"
        }
      ]
    },
    {
      "id": "laozi8-014",
      "order": 14,
      "text": "不自见，故明；不自是，故彰；不自伐，故有功；不自矜，故长。",
      "translation": "不自我表现，所以显明；不自以为是，所以彰显；不自我夸耀，所以有功；不自高自大，所以能长久。",
      "tokens": [
        {
          "surface": "见",
          "pos": "动词",
          "gloss": "通“现”，自我表现"
        },
        {
          "surface": "明",
          "pos": "形容词",
          "gloss": "显明"
        },
        {
          "surface": "是",
          "pos": "动词",
          "gloss": "认为对，自以为是"
        },
        {
          "surface": "彰",
          "pos": "形容词",
          "gloss": "彰显"
        },
        {
          "surface": "伐",
          "pos": "动词",
          "gloss": "夸耀"
        },
        {
          "surface": "矜",
          "pos": "动词",
          "gloss": "自高自大"
        },
        {
          "surface": "长",
          "pos": "动词",
          "gloss": "长久"
        }
      ]
    },
    {
      "id": "laozi8-015",
      "order": 15,
      "text": "夫唯不争，故天下莫能与之争。",
      "translation": "正因为不与人争，所以天下没有人能与他相争。",
      "tokens": [
        {
          "surface": "夫唯",
          "pos": "连词",
          "gloss": "正因为"
        },
        {
          "surface": "争",
          "pos": "动词",
          "gloss": "争夺"
        },
        {
          "surface": "莫",
          "pos": "代词",
          "gloss": "没有谁"
        },
        {
          "surface": "与",
          "pos": "介词",
          "gloss": "跟，同"
        }
      ]
    },
    {
      "id": "laozi8-016",
      "order": 16,
      "text": "古之所谓“曲则全”者，岂虚言哉？",
      "translation": "古人所说的“委曲反而能保全”，难道是空话吗？",
      "tokens": [
        {
          "surface": "所谓",
          "pos": "固定结构",
          "gloss": "所说的"
        },
        {
          "surface": "曲则全",
          "pos": "名词",
          "gloss": "委曲反而能保全"
        },
        {
          "surface": "岂",
          "pos": "副词",
          "gloss": "难道"
        },
        {
          "surface": "虚言",
          "pos": "名词",
          "gloss": "空话"
        }
      ]
    },
    {
      "id": "laozi8-017",
      "order": 17,
      "text": "诚全而归之。",
      "translation": "它确实能使保全归于自身。",
      "tokens": [
        {
          "surface": "诚",
          "pos": "副词",
          "gloss": "确实"
        },
        {
          "surface": "全",
          "pos": "名词",
          "gloss": "保全的功效"
        },
        {
          "surface": "归",
          "pos": "动词",
          "gloss": "归于"
        }
      ]
    },
    {
      "id": "laozi8-018",
      "order": 18,
      "text": "企者不立，跨者不行，自见者不明，自是者不彰，自伐者无功，自矜者不长。",
      "translation": "踮起脚跟的人站不稳，迈大步的人走不远，自我表现的人不高明，自以为是的人不彰显，自我夸耀的人没有功劳，自高自大的人不能长久。",
      "tokens": [
        {
          "surface": "企",
          "pos": "动词",
          "gloss": "踮起脚跟"
        },
        {
          "surface": "跨",
          "pos": "动词",
          "gloss": "迈大步"
        },
        {
          "surface": "见",
          "pos": "动词",
          "gloss": "通“现”，自我表现"
        },
        {
          "surface": "是",
          "pos": "动词",
          "gloss": "自以为是"
        },
        {
          "surface": "伐",
          "pos": "动词",
          "gloss": "夸耀"
        },
        {
          "surface": "矜",
          "pos": "动词",
          "gloss": "自高自大"
        },
        {
          "surface": "长",
          "pos": "动词",
          "gloss": "长久"
        }
      ]
    },
    {
      "id": "laozi8-019",
      "order": 19,
      "text": "其在道也，曰余食赘行，物或恶之，故有道者不处。",
      "translation": "这些行为从“道”的角度看，叫作剩饭赘瘤，人们都厌恶它们，所以有道的人不这样做。",
      "tokens": [
        {
          "surface": "其",
          "pos": "代词",
          "gloss": "这些行为"
        },
        {
          "surface": "余食",
          "pos": "名词",
          "gloss": "剩饭"
        },
        {
          "surface": "赘行",
          "pos": "名词",
          "gloss": "多余的赘瘤"
        },
        {
          "surface": "或",
          "pos": "副词",
          "gloss": "常常"
        },
        {
          "surface": "恶",
          "pos": "动词",
          "gloss": "厌恶"
        },
        {
          "surface": "处",
          "pos": "动词",
          "gloss": "居处，这样做"
        }
      ]
    },
    {
      "id": "laozi8-020",
      "order": 20,
      "text": "善行无辙迹；善言无瑕谪；善数不用筹策；善闭无关楗而不可开；善结，无绳约而不可解。",
      "translation": "善于行走的不留车辙痕迹，善于言谈的没有过失，善于计算的不用筹码，善于关闭的不用门闩却无法打开，善于捆缚的不用绳索却无法解开。",
      "tokens": [
        {
          "surface": "辙迹",
          "pos": "名词",
          "gloss": "车辙痕迹"
        },
        {
          "surface": "瑕谪",
          "pos": "名词",
          "gloss": "过失，缺点"
        },
        {
          "surface": "数",
          "pos": "动词",
          "gloss": "计算"
        },
        {
          "surface": "筹策",
          "pos": "名词",
          "gloss": "计数用的筹码"
        },
        {
          "surface": "关楗",
          "pos": "名词",
          "gloss": "门闩"
        },
        {
          "surface": "绳约",
          "pos": "名词",
          "gloss": "绳索"
        },
        {
          "surface": "解",
          "pos": "动词",
          "gloss": "解开"
        }
      ]
    },
    {
      "id": "laozi8-021",
      "order": 21,
      "text": "是以圣人常善救人，故无弃人；常善救物，故无弃物。",
      "translation": "因此圣人常常善于救助人，所以没有被遗弃的人；常常善于物尽其用，所以没有被废弃的物。",
      "tokens": [
        {
          "surface": "是以",
          "pos": "连词",
          "gloss": "因此"
        },
        {
          "surface": "救",
          "pos": "动词",
          "gloss": "救助，挽救"
        },
        {
          "surface": "弃人",
          "pos": "名词",
          "gloss": "被遗弃的人"
        },
        {
          "surface": "弃物",
          "pos": "名词",
          "gloss": "被废弃的物"
        }
      ]
    },
    {
      "id": "laozi8-022",
      "order": 22,
      "text": "是谓袭明。",
      "translation": "这就叫作承袭常道的明智。",
      "tokens": [
        {
          "surface": "是",
          "pos": "代词",
          "gloss": "这"
        },
        {
          "surface": "谓",
          "pos": "动词",
          "gloss": "叫作"
        },
        {
          "surface": "袭明",
          "pos": "名词",
          "gloss": "承袭常道的明智"
        }
      ]
    },
    {
      "id": "laozi8-023",
      "order": 23,
      "text": "故善人者，不善人之师；不善人者，善人之资。",
      "translation": "所以善人是善人的老师，不善的人是善人的借鉴。",
      "tokens": [
        {
          "surface": "善人",
          "pos": "名词",
          "gloss": "善良的人"
